# Copie este archivo a .env (NO se versiona) y ajuste los valores.
# Los valores de ejemplo son solo para desarrollo local.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# --- Base de datos (MySQL 8 del docker-compose.dev.yml, puerto del host 3310) ---
MYSQL_HOST_PORT=3310
MYSQL_ROOT_PASSWORD=dev_root_change_me
MYSQL_APP_PASSWORD=dev_app_change_me
DATABASE_URL=mysql://apidental:dev_app_change_me@127.0.0.1:3310/apidental_dev
# Usada por la suite e2e (se recrea completamente en cada ejecución):
TEST_DATABASE_URL=mysql://apidental:dev_app_change_me@127.0.0.1:3310/apidental_test
# Prisma migrate dev usa una base sombra; el usuario de desarrollo puede crear bases apidental_*
SHADOW_DATABASE_URL=mysql://apidental:dev_app_change_me@127.0.0.1:3310/apidental_shadow

# --- JWT (genere uno propio: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=change_me_dev_only_please_generate_a_long_random_secret_value
JWT_ISSUER=apidental-api
JWT_AUDIENCE=apidental-admin
JWT_ACCESS_TTL_SECONDS=900

# --- Sesiones (refresh token en cookie HttpOnly) ---
# Inactividad máxima antes de pedir inicio de sesión (el refresh token rota en cada renovación).
REFRESH_TTL_SECONDS=28800
# Tope absoluto de una sesión, aunque se renueve sin parar.
SESSION_MAX_SECONDS=604800
# 0 = estricto: reutilizar un refresh token ya rotado revoca la sesión. >0 tolera renovaciones simultáneas (menos seguro).
REFRESH_REUSE_GRACE_SECONDS=0
# Por defecto: true en producción (cookie __Host-, solo HTTPS), false en desarrollo (http://localhost).
# COOKIE_SECURE=true
# Vida de la prueba de reautenticación (de un solo uso). NO es una firma digital, legal ni clínica.
REAUTH_TTL_SECONDS=120

# --- Invitaciones y aprovisionamiento ---
INVITATION_TTL_HOURS=72
PROVISIONING_RECORD_TTL_DAYS=30
# Canal de entrega del enlace de invitación:
#   dev      = el enlace vuelve en la respuesta (SOLO desarrollo/pruebas; la API se niega a iniciar así en producción)
#   webhook  = POST firmado con HMAC a su sistema de envío (correo, SMS, cola...). No se asume proveedor.
#   disabled = no se pueden crear invitaciones (valor por defecto en producción)
INVITATION_DELIVERY_MODE=dev
# INVITATION_WEBHOOK_URL=https://envios.interno.example/hooks/apidental
# INVITATION_WEBHOOK_SECRET=            # >= 32 caracteres: openssl rand -base64 48
# Pantalla de aceptación del panel; el token se agrega como fragmento (#token=...), nunca en la ruta.
INVITATION_ACCEPT_BASE_URL=http://localhost:5173/admin/aceptar-invitacion

# --- Recuperación de contraseña (usa el MISMO canal de entrega que las invitaciones) ---
# Vigencia del enlace de un solo uso.
PASSWORD_RECOVERY_TTL_MINUTES=30
# Espera mínima entre solicitudes para una misma cuenta (las que la incumplen se ignoran en silencio).
PASSWORD_RECOVERY_COOLDOWN_SECONDS=60
# Tope diario de solicitudes por cuenta.
PASSWORD_RECOVERY_MAX_PER_DAY=5
# Pantalla del panel; el token se agrega como fragmento (#token=...). https obligatorio en producción
# si el canal no es "disabled".
PASSWORD_RECOVERY_BASE_URL=http://localhost:5173/admin/restablecer-contrasena

# --- Cifrado de campos (PREPARADO; ningún campo lo usa todavía) ---
# El requisito efectivo antes de datos reales es el cifrado del VOLUMEN y de los RESPALDOS externos, y la gestión
# segura de secretos (ver docs/arquitectura/incremento-3-2-antecedentes-alertas.md). Esta capa queda apagada.
FIELD_ENCRYPTION_MODE=off
# FIELD_ENCRYPTION_KEY_ID=k1
# FIELD_ENCRYPTION_KEY=                 # 32 bytes en base64: openssl rand -base64 32 (nunca en el repositorio)
# FIELD_ENCRYPTION_OLD_KEYS=            # claves anteriores para descifrar tras una rotación: id:base64,id:base64

# --- Mantenimiento de seguridad (npm run maintenance) ---
# Días que se conservan los registros CERRADOS antes de depurarlos. La auditoría, los usuarios, las
# asignaciones y el registro de aprovisionamiento NUNCA se depuran. Retención [por validar] con asesoría legal.
RETENTION_SESSIONS_DAYS=30
RETENTION_REAUTH_DAYS=7
RETENTION_INVITATIONS_DAYS=90      # mínimo 30 (lo impone también la base de datos)
RETENTION_RECOVERIES_DAYS=30       # mínimo 30 (lo impone también la base de datos)
# Se procesa por lotes; si hay más trabajo que BATCH_SIZE x MAX_BATCHES, la siguiente ejecución continúa.
MAINTENANCE_BATCH_SIZE=500
MAINTENANCE_MAX_BATCHES=20

# --- CORS: orígenes del panel, separados por coma ---
# Producción: https://dental.apiworking.com.pe
CORS_ORIGINS=http://localhost:5173

# --- Adjuntos de pacientes: directorio PRIVADO en disco (jamás en el webroot ni servido por Nginx) ---
# Producción: ruta ABSOLUTA, p. ej. /var/lib/apidental/files (propietario apidental, modo 0700, incluida en los respaldos).
ATTACHMENTS_DIR=./storage/attachments
ATTACHMENT_MAX_BYTES=10485760

# --- Detrás de Nginx en el VPS use 1 para que req.ip sea la IP real del cliente ---
TRUST_PROXY=0

# --- Protección contra fuerza bruta ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- Solo desarrollo: administrador creado por el seed (ignorado en producción) ---
# Defina ambos para crear un usuario con PLATFORM_ADMIN y CLINIC_ADMIN de la Clínica Demo.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Contraseña de las cuentas demo FICTICIAS (odontóloga, asistente, recepción y Director @apidental.test). Si se omite, se usa SEED_ADMIN_PASSWORD. >= 12 caracteres.
# SEED_DEMO_PASSWORD=

# --- Integraciones (Apiworking) ---
# off  = sin integraciones (por defecto).
# mock = SIMULADORES para demostración: cobros, comprobantes "DEMO — NO VÁLIDO PARA SUNAT", fidelización y reseñas
#        con datos ficticios. Sin credenciales, sin endpoints reales, sin emisión SUNAT. No existe modo "real" todavía.
INTEGRATIONS_MODE=off
# Con NODE_ENV=production, mock exige esta confirmación explícita (solo demostraciones).
# INTEGRATIONS_MOCK_ALLOW_PRODUCTION=false
# Procesador de la cola en ms (0 = solo bajo demanda con "Procesar cola").
# INTEGRATIONS_WORKER_INTERVAL_MS=0
