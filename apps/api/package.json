{
  "name": "@apidental/api",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS de ApiDental",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --type-aware src/ test/ prisma/",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:create-admin": "tsx prisma/create-admin.ts",
    "maintenance": "node dist/maintenance/cli.js",
    "maintenance:dry-run": "node dist/maintenance/cli.js --dry-run"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "pdfkit": "0.19.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "0.17.6",
    "@types/supertest": "^7.0.0",
    "mariadb": "3.5.4",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prisma": "7.10.0",
    "supertest": "^7.0.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.4"
  }
}
