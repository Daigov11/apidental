// Fundación multiclínica y acceso (incremento 1).
// Convención: tablas y columnas en snake_case (@@map/@map), ids UUID (CHAR(36)).
// Sin tablas clínicas, de agenda, pagos ni integraciones todavía.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

enum ClinicStatus {
  ACTIVE
  INACTIVE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AssignmentStatus {
  ACTIVE
  INACTIVE
}

/// Alcance del rol: PLATFORM = operación de la plataforma (sin clínica);
/// CLINIC = rol que siempre se ejerce dentro de una clínica concreta.
enum RoleScope {
  PLATFORM
  CLINIC
}

model Clinic {
  id                  String       @id @default(uuid()) @db.Char(36)
  name                String       @db.VarChar(160)
  legalName           String?      @map("legal_name") @db.VarChar(200)
  /// RUC opcional; único cuando existe (MySQL admite varios NULL en un índice único).
  ruc                 String?      @unique @db.VarChar(11)
  /// Branding básico configurable por clínica.
  brandDisplayName    String?      @map("brand_display_name") @db.VarChar(120)
  brandLogoUrl        String?      @map("brand_logo_url") @db.VarChar(500)
  brandPrimaryColor   String?      @map("brand_primary_color") @db.VarChar(9)
  brandSecondaryColor String?      @map("brand_secondary_color") @db.VarChar(9)
  status              ClinicStatus @default(ACTIVE)
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  branches            Branch[]
  assignments         UserAssignment[]
  patients            Patient[]
  invitations         Invitation[]
  provisioningRecords ProvisioningRecord[]

  @@map("clinics")
}

model Branch {
  id        String       @id @default(uuid()) @db.Char(36)
  clinicId  String       @map("clinic_id") @db.Char(36)
  name      String       @db.VarChar(160)
  address   String?      @db.VarChar(300)
  status    BranchStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  clinic            Clinic                    @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  assignments       UserAssignment[]
  invitations       Invitation[]
  careRelationships PatientCareRelationship[]

  @@unique([clinicId, name])
  // Permite la clave foránea compuesta (branch_id, clinic_id) desde user_assignments,
  // que garantiza en BD que una sede pertenece a la clínica de la asignación.
  @@unique([id, clinicId])
  @@map("branches")
}

model User {
  id                  String     @id @default(uuid()) @db.Char(36)
  /// Siempre en minúsculas (se normaliza en la aplicación).
  email               String     @unique @db.VarChar(254)
  passwordHash        String     @map("password_hash") @db.VarChar(255)
  firstName           String     @map("first_name") @db.VarChar(100)
  lastName            String     @map("last_name") @db.VarChar(100)
  status              UserStatus @default(ACTIVE)
  lastLoginAt         DateTime?  @map("last_login_at")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  /// Deshabilitación (nunca se elimina al usuario): quién, cuándo, por qué y si fue la plataforma
  /// (solo la plataforma puede reactivar una cuenta que ella deshabilitó).
  disabledAt          DateTime?  @map("disabled_at") @db.DateTime(3)
  disabledById        String?    @map("disabled_by_id") @db.Char(36)
  disabledReason      String?    @map("disabled_reason") @db.VarChar(300)
  disabledByPlatform  Boolean    @default(false) @map("disabled_by_platform")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  assignments        UserAssignment[]
  sessions           AuthSession[]
  reauthProofs       ReauthProof[]
  passwordRecoveries PasswordRecovery[]
  careRelationships  PatientCareRelationship[]
  clinicalGrants     ClinicalAccessGrant[]

  @@map("users")
}

model Role {
  id          String    @id @default(uuid()) @db.Char(36)
  /// Código estable usado por el código de la aplicación (p. ej. CLINIC_ADMIN).
  code        String    @unique @db.VarChar(50)
  name        String    @db.VarChar(100)
  scope       RoleScope
  description String?   @db.VarChar(300)

  permissions RolePermission[]
  assignments UserAssignment[]
  invitations Invitation[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Char(36)
  /// Formato modulo:accion, p. ej. branch:read.
  code        String  @unique @db.VarChar(80)
  description String? @db.VarChar(300)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Char(36)
  permissionId String @map("permission_id") @db.Char(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Única fuente de permisos de un usuario: sin asignación activa no hay acceso.
/// - rol PLATFORM  => clinic_id y branch_id nulos.
/// - rol CLINIC    => clinic_id obligatorio; branch_id nulo = toda la clínica,
///                    branch_id informado = solo esa sede.
/// Esas reglas dependen del rol y se validan en la aplicación (AssignmentsService);
/// la BD garantiza que branch_id requiera clinic_id y que la sede pertenezca a la clínica.
model UserAssignment {
  id            String           @id @default(uuid()) @db.Char(36)
  userId        String           @map("user_id") @db.Char(36)
  roleId        String           @map("role_id") @db.Char(36)
  clinicId      String?          @map("clinic_id") @db.Char(36)
  branchId      String?          @map("branch_id") @db.Char(36)
  /// Evita duplicados con columnas NULL: "userId|roleId|clinicId-o-*|branchId-o-*".
  assignmentKey String           @unique @map("assignment_key") @db.VarChar(160)
  /// Quién otorgó el rol (invitó o asignó). Alimenta la separación de funciones: quien otorgó un rol
  /// clínico a una cuenta no puede además asignarle pacientes. Nulo en datos anteriores a 3.1.
  grantedById   String?          @map("granted_by_id") @db.Char(36)
  status        AssignmentStatus @default(ACTIVE)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch Branch? @relation(fields: [branchId, clinicId], references: [id, clinicId], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, status])
  @@index([clinicId, status])
  @@index([branchId])
  @@index([roleId])
  @@map("user_assignments")
}

/// Registro de auditoría inmutable (los triggers de la migración bloquean UPDATE y DELETE).
/// Sin claves foráneas a propósito: el registro debe sobrevivir a cambios en otras tablas.
model AuditLog {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String?  @map("user_id") @db.Char(36)
  clinicId  String?  @map("clinic_id") @db.Char(36)
  branchId  String?  @map("branch_id") @db.Char(36)
  /// Paciente involucrado (si aplica): permite responder "quién accedió a este paciente".
  patientId String?  @map("patient_id") @db.Char(36)
  action    String   @db.VarChar(64)
  entity    String   @db.VarChar(64)
  entityId  String?  @map("entity_id") @db.VarChar(64)
  ip        String?  @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  /// Resumen seguro de cambios: nunca contraseñas, tokens ni datos clínicos.
  summary   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([clinicId, createdAt])
  @@index([patientId, createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Incremento 2: pacientes, contactos, consentimientos y adjuntos privados.
// Datos demográficos y administrativos únicamente: NO hay datos clínicos aquí.
// Nada se elimina físicamente (triggers de la migración bloquean DELETE).
// Todas las tablas hijas llevan clinic_id y una FK compuesta (patient_id, clinic_id)
// que impide a nivel de BD asociar datos de una clínica a un paciente de otra.
// ---------------------------------------------------------------------------

enum PatientStatus {
  ACTIVE
  INACTIVE
}

enum Sex {
  FEMALE
  MALE
  OTHER
}

enum IdentifierType {
  DNI
  CE
  PASSPORT
}

/// Historial de identificadores y contactos: el valor vigente es ACTIVE; los reemplazados quedan SUPERSEDED.
enum RecordStatus {
  ACTIVE
  SUPERSEDED
}

enum ContactType {
  MOBILE
  PHONE
  EMAIL
  ADDRESS
}

enum GuardianRelationship {
  MOTHER
  FATHER
  LEGAL_GUARDIAN
  GRANDPARENT
  SIBLING
  OTHER
}

enum GuardianLinkStatus {
  ACTIVE
  ENDED
}

enum ConsentType {
  CLINICAL
  LOYALTY
  MARKETING
}

enum ConsentStatus {
  GRANTED
  REVOKED
}

enum ConsentGrantedBy {
  PATIENT
  GUARDIAN
}

/// Solo categorías administrativas. Radiografías, fotos clínicas y similares llegarán con el
/// módulo clínico y con permisos propios; no se mezclan aquí.
enum AttachmentCategory {
  CONSENT
  IDENTITY_DOCUMENT
  OTHER_ADMINISTRATIVE
}

enum AttachmentStatus {
  ACTIVE
  REMOVED
}

model Patient {
  id              String        @id @default(uuid()) @db.Char(36)
  clinicId        String        @map("clinic_id") @db.Char(36)
  firstName       String        @map("first_name") @db.VarChar(100)
  lastName        String        @map("last_name") @db.VarChar(100)
  secondLastName  String?       @map("second_last_name") @db.VarChar(100)
  birthDate       DateTime?     @map("birth_date") @db.Date
  sex             Sex?
  status          PatientStatus @default(ACTIVE)
  statusReason    String?       @map("status_reason") @db.VarChar(300)
  /// Sede donde se registró (informativo: el paciente pertenece a la clínica, no a la sede).
  createdBranchId String?       @map("created_branch_id") @db.Char(36)
  createdById     String        @map("created_by_id") @db.Char(36)
  updatedById     String?       @map("updated_by_id") @db.Char(36)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  clinic            Clinic                    @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  identifiers       PatientIdentifier[]
  contacts          PatientContact[]
  guardians         PatientGuardian[]
  consents          PatientConsent[]
  attachments       Attachment[]
  careRelationships PatientCareRelationship[]
  clinicalGrants    ClinicalAccessGrant[]
  historyEntries    ClinicalHistoryEntry[]
  clinicalAlerts    ClinicalAlert[]

  @@unique([id, clinicId])
  @@index([clinicId, lastName, firstName])
  @@index([clinicId, birthDate])
  @@index([clinicId, status])
  @@map("patients")
}

model PatientIdentifier {
  id             String         @id @default(uuid()) @db.Char(36)
  clinicId       String         @map("clinic_id") @db.Char(36)
  patientId      String         @map("patient_id") @db.Char(36)
  type           IdentifierType
  /// Normalizado (DNI: 8 dígitos; CE/pasaporte: alfanumérico en mayúsculas).
  number         String         @db.VarChar(20)
  status         RecordStatus   @default(ACTIVE)
  /// "clinica|tipo|numero" mientras esté ACTIVE, NULL al reemplazarse:
  /// un mismo documento no puede estar vigente en dos pacientes de la clínica.
  activeKey      String?        @unique @map("active_key") @db.VarChar(80)
  /// "paciente|tipo" mientras esté ACTIVE: un paciente tiene un solo identificador vigente por tipo.
  patientTypeKey String?        @unique @map("patient_type_key") @db.VarChar(80)
  changeReason   String?        @map("change_reason") @db.VarChar(300)
  supersededAt   DateTime?      @map("superseded_at")
  createdById    String         @map("created_by_id") @db.Char(36)
  createdAt      DateTime       @default(now()) @map("created_at")

  patient Patient @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@index([patientId])
  @@index([clinicId, number])
  @@map("patient_identifiers")
}

/// Celular y correo NO son únicos (se comparten entre familiares y cambian): solo alimentan
/// las advertencias de posible duplicado.
model PatientContact {
  id           String       @id @default(uuid()) @db.Char(36)
  clinicId     String       @map("clinic_id") @db.Char(36)
  patientId    String       @map("patient_id") @db.Char(36)
  type         ContactType
  value        String       @db.VarChar(300)
  /// Valor normalizado para comparar (dígitos / correo en minúsculas). NULL para direcciones.
  valueKey     String?      @map("value_key") @db.VarChar(254)
  label        String?      @db.VarChar(60)
  isPrimary    Boolean      @default(false) @map("is_primary")
  status       RecordStatus @default(ACTIVE)
  /// "paciente|tipo" si es el contacto principal vigente: máximo uno por tipo.
  primaryKey   String?      @unique @map("primary_key") @db.VarChar(80)
  /// "paciente|tipo|valor" mientras esté vigente: sin repetir el mismo valor en un paciente.
  activeKey    String?      @unique @map("active_key") @db.VarChar(300)
  changeReason String?      @map("change_reason") @db.VarChar(300)
  supersededAt DateTime?    @map("superseded_at")
  createdById  String       @map("created_by_id") @db.Char(36)
  createdAt    DateTime     @default(now()) @map("created_at")

  patient Patient @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@index([patientId, status])
  @@index([clinicId, type, valueKey])
  @@map("patient_contacts")
}

/// Representante o apoderado (persona). Puede serlo de varios pacientes (hermanos).
model Guardian {
  id               String          @id @default(uuid()) @db.Char(36)
  clinicId         String          @map("clinic_id") @db.Char(36)
  firstName        String          @map("first_name") @db.VarChar(100)
  lastName         String          @map("last_name") @db.VarChar(100)
  secondLastName   String?         @map("second_last_name") @db.VarChar(100)
  identifierType   IdentifierType? @map("identifier_type")
  identifierNumber String?         @map("identifier_number") @db.VarChar(20)
  mobile           String?         @db.VarChar(20)
  email            String?         @db.VarChar(254)
  createdById      String          @map("created_by_id") @db.Char(36)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  links PatientGuardian[]

  @@unique([id, clinicId])
  @@index([clinicId, lastName])
  @@index([clinicId, identifierNumber])
  @@map("guardians")
}

model PatientGuardian {
  id                    String               @id @default(uuid()) @db.Char(36)
  clinicId              String               @map("clinic_id") @db.Char(36)
  patientId             String               @map("patient_id") @db.Char(36)
  guardianId            String               @map("guardian_id") @db.Char(36)
  relationship          GuardianRelationship
  isPrimary             Boolean              @default(false) @map("is_primary")
  isLegalRepresentative Boolean              @default(false) @map("is_legal_representative")
  status                GuardianLinkStatus   @default(ACTIVE)
  /// "paciente|apoderado" mientras esté vigente: sin vínculos duplicados.
  activeKey             String?              @unique @map("active_key") @db.VarChar(80)
  endedAt               DateTime?            @map("ended_at")
  endReason             String?              @map("end_reason") @db.VarChar(300)
  createdById           String               @map("created_by_id") @db.Char(36)
  createdAt             DateTime             @default(now()) @map("created_at")

  patient  Patient  @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  guardian Guardian @relation(fields: [guardianId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@index([patientId, status])
  @@index([guardianId])
  @@map("patient_guardians")
}

/// Un consentimiento es un registro independiente; revocar no lo borra ni lo edita.
/// Tipos separados: clínico, fidelización y marketing. Validez legal y formatos: por validar.
model PatientConsent {
  id               String           @id @default(uuid()) @db.Char(36)
  clinicId         String           @map("clinic_id") @db.Char(36)
  patientId        String           @map("patient_id") @db.Char(36)
  type             ConsentType
  status           ConsentStatus    @default(GRANTED)
  documentTitle    String           @map("document_title") @db.VarChar(200)
  documentVersion  String           @map("document_version") @db.VarChar(60)
  grantedAt        DateTime         @map("granted_at") @db.DateTime(3)
  grantedBy        ConsentGrantedBy @map("granted_by")
  guardianId       String?          @map("guardian_id") @db.Char(36)
  notes            String?          @db.VarChar(500)
  /// "paciente|tipo" mientras esté GRANTED: un solo consentimiento vigente por tipo.
  activeKey        String?          @unique @map("active_key") @db.VarChar(80)
  revokedAt        DateTime?        @map("revoked_at") @db.DateTime(3)
  revokedById      String?          @map("revoked_by_id") @db.Char(36)
  revocationReason String?          @map("revocation_reason") @db.VarChar(300)
  createdById      String           @map("created_by_id") @db.Char(36)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  patient     Patient      @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  attachments Attachment[]

  @@index([patientId, type])
  @@index([clinicId, type, status])
  @@map("patient_consents")
}

/// Metadatos de un archivo. El contenido vive en disco privado (jamás en MySQL) bajo
/// storage_key, que nunca se expone por la API; el acceso es solo por endpoints autorizados.
model Attachment {
  id            String             @id @default(uuid()) @db.Char(36)
  clinicId      String             @map("clinic_id") @db.Char(36)
  patientId     String             @map("patient_id") @db.Char(36)
  consentId     String?            @map("consent_id") @db.Char(36)
  category      AttachmentCategory
  originalName  String             @map("original_name") @db.VarChar(160)
  /// MIME detectado por contenido (no el declarado por el cliente).
  mimeType      String             @map("mime_type") @db.VarChar(100)
  sizeBytes     Int                @map("size_bytes")
  sha256        String             @db.Char(64)
  storageKey    String             @unique @map("storage_key") @db.VarChar(120)
  description   String?            @db.VarChar(300)
  status        AttachmentStatus   @default(ACTIVE)
  removedAt     DateTime?          @map("removed_at")
  removedById   String?            @map("removed_by_id") @db.Char(36)
  removalReason String?            @map("removal_reason") @db.VarChar(300)
  uploadedById  String             @map("uploaded_by_id") @db.Char(36)
  createdAt     DateTime           @default(now()) @map("created_at")

  patient Patient         @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  consent PatientConsent? @relation(fields: [consentId], references: [id], onDelete: Restrict)

  @@index([patientId, status])
  @@index([consentId])
  @@index([clinicId, sha256])
  @@map("attachments")
}

// ---------------------------------------------------------------------------
// Incremento 3.0: sesiones con refresh token, reautenticación, invitaciones y
// aprovisionamiento formal. NINGÚN secreto se guarda en claro: solo su SHA-256.
// ---------------------------------------------------------------------------

enum SessionRevokeReason {
  LOGOUT
  LOGOUT_ALL
  REUSE_DETECTED
  EXPIRED
  USER_DISABLED
  PASSWORD_RESET
}

enum RefreshTokenStatus {
  ACTIVE
  ROTATED
  REVOKED
}

/// Propósitos de la prueba de reautenticación. Los clínicos están reservados para los
/// siguientes sub-incrementos; hoy solo AUTHORIZE_DIRECTOR_PROVISIONING tiene consumidor.
/// Una reautenticación NO es una firma digital, legal ni clínica.
enum ReauthPurpose {
  CLOSE_CLINICAL_NOTE
  CORRECT_CLINICAL_NOTE
  MARK_CLINICAL_NOTE_ERROR
  CLINICAL_READ_ALL
  AUTHORIZE_DIRECTOR_PROVISIONING
}

enum PasswordRecoveryStatus {
  PENDING
  USED
  REVOKED
  EXPIRED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum ProvisioningKind {
  FIRST_CLINICAL_DIRECTOR
}

enum ProvisioningStatus {
  ACTIVE
  CONSUMED
  REVOKED
  EXPIRED
}

/// Una sesión es la "familia" de sus refresh tokens: si se detecta la reutilización de uno ya
/// rotado, se revoca la sesión completa. El access token lleva el id de sesión (sid) y deja de
/// valer en cuanto la sesión se revoca.
model AuthSession {
  id                String               @id @default(uuid()) @db.Char(36)
  userId            String               @map("user_id") @db.Char(36)
  createdAt         DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  lastUsedAt        DateTime             @default(now()) @map("last_used_at") @db.DateTime(3)
  /// Tope absoluto de la sesión, aunque se siga renovando.
  absoluteExpiresAt DateTime             @map("absolute_expires_at") @db.DateTime(3)
  revokedAt         DateTime?            @map("revoked_at") @db.DateTime(3)
  revokedReason     SessionRevokeReason? @map("revoked_reason")
  ip                String?              @db.VarChar(64)
  userAgent         String?              @map("user_agent") @db.VarChar(255)
  /// Último contexto activo, para restaurarlo al renovar el access token.
  contextSet        Boolean              @default(false) @map("context_set")
  contextClinicId   String?              @map("context_clinic_id") @db.Char(36)
  contextBranchId   String?              @map("context_branch_id") @db.Char(36)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  reauthProofs  ReauthProof[]

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id           String             @id @default(uuid()) @db.Char(36)
  sessionId    String             @map("session_id") @db.Char(36)
  /// SHA-256 (hex) del token. El token en claro solo existe en la cookie del cliente.
  tokenHash    String             @unique @map("token_hash") @db.Char(64)
  status       RefreshTokenStatus @default(ACTIVE)
  createdAt    DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt    DateTime           @map("expires_at") @db.DateTime(3)
  rotatedAt    DateTime?          @map("rotated_at") @db.DateTime(3)
  replacedById String?            @map("replaced_by_id") @db.Char(36)

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@map("refresh_tokens")
}

/// Prueba de reautenticación: vida corta, un solo uso, ligada a usuario, sesión, propósito y objetivo.
model ReauthProof {
  id        String        @id @default(uuid()) @db.Char(36)
  userId    String        @map("user_id") @db.Char(36)
  sessionId String        @map("session_id") @db.Char(36)
  purpose   ReauthPurpose
  /// Objeto sobre el que se autoriza (p. ej. la clínica o la nota); NULL si no aplica.
  targetId  String?       @map("target_id") @db.VarChar(64)
  tokenHash String        @unique @map("token_hash") @db.Char(64)
  createdAt DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt DateTime      @map("expires_at") @db.DateTime(3)
  usedAt    DateTime?     @map("used_at") @db.DateTime(3)
  ip        String?       @db.VarChar(64)

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("reauth_proofs")
}

/// Invitación de un solo uso. El token viaja solo por el canal de entrega; aquí solo su hash.
/// Aceptarla crea (o enlaza) al usuario con una asignación; nunca fija la contraseña de otra persona.
model Invitation {
  id               String           @id @default(uuid()) @db.Char(36)
  email            String           @db.VarChar(254)
  roleId           String           @map("role_id") @db.Char(36)
  clinicId         String?          @map("clinic_id") @db.Char(36)
  branchId         String?          @map("branch_id") @db.Char(36)
  tokenHash        String           @unique @map("token_hash") @db.Char(64)
  status           InvitationStatus @default(PENDING)
  /// "email|rol|clínica|sede" mientras esté PENDING: sin invitaciones pendientes duplicadas.
  pendingKey       String?          @unique @map("pending_key") @db.VarChar(400)
  expiresAt        DateTime         @map("expires_at") @db.DateTime(3)
  createdById      String           @map("created_by_id") @db.Char(36)
  createdAt        DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  /// true si la emitió la plataforma (solo para el primer CLINIC_ADMIN): al aceptarse se vuelve a
  /// comprobar que la clínica siga sin administrador, para que la plataforma no pueda infiltrarse después.
  issuedByPlatform Boolean          @default(false) @map("issued_by_platform")

  deliveryStatus    DeliveryStatus @default(PENDING) @map("delivery_status")
  deliveryAttempts  Int            @default(0) @map("delivery_attempts")
  lastDeliveryAt    DateTime?      @map("last_delivery_at") @db.DateTime(3)
  /// Motivo genérico y saneado (nunca la URL, el token ni la respuesta del canal).
  lastDeliveryError String?        @map("last_delivery_error") @db.VarChar(120)
  tokenRotatedAt    DateTime?      @map("token_rotated_at") @db.DateTime(3)

  acceptedAt     DateTime? @map("accepted_at") @db.DateTime(3)
  acceptedUserId String?   @map("accepted_user_id") @db.Char(36)
  revokedAt      DateTime? @map("revoked_at") @db.DateTime(3)
  revokedById    String?   @map("revoked_by_id") @db.Char(36)
  revokeReason   String?   @map("revoke_reason") @db.VarChar(300)
  expiredAt      DateTime? @map("expired_at") @db.DateTime(3)

  /// Solo para la invitación del primer Director Clínico.
  provisioningRecordId String? @map("provisioning_record_id") @db.Char(36)

  role               Role                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  clinic             Clinic?             @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch             Branch?             @relation(fields: [branchId, clinicId], references: [id, clinicId], onDelete: Restrict, onUpdate: Restrict)
  provisioningRecord ProvisioningRecord? @relation(fields: [provisioningRecordId], references: [id], onDelete: Restrict)

  @@index([clinicId, status])
  @@index([email])
  @@index([status, expiresAt])
  @@map("invitations")
}

/// Registro formal de aprovisionamiento autorizado por la clínica (primer Director Clínico).
/// LIMITACIÓN: sin firma ni flujo contractual integrado, es una declaración asentada por el
/// administrador de la clínica; el sistema NO verifica la autenticidad del documento citado.
model ProvisioningRecord {
  id        String             @id @default(uuid()) @db.Char(36)
  clinicId  String             @map("clinic_id") @db.Char(36)
  kind      ProvisioningKind
  status    ProvisioningStatus @default(ACTIVE)
  /// "clínica|tipo" mientras esté ACTIVE: un solo registro vigente por clínica y tipo.
  activeKey String?            @unique @map("active_key") @db.VarChar(80)

  designeeName  String @map("designee_name") @db.VarChar(200)
  /// La invitación del Director debe dirigirse exactamente a este correo.
  designeeEmail String @map("designee_email") @db.VarChar(254)

  authorizedByName           String   @map("authorized_by_name") @db.VarChar(200)
  authorizedByPosition       String   @map("authorized_by_position") @db.VarChar(120)
  authorizedByDocumentType   String   @map("authorized_by_document_type") @db.VarChar(10)
  authorizedByDocumentNumber String   @map("authorized_by_document_number") @db.VarChar(20)
  authorizationReference     String   @map("authorization_reference") @db.VarChar(200)
  authorizationDate          DateTime @map("authorization_date") @db.Date
  notes                      String?  @db.VarChar(500)

  recordedById String   @map("recorded_by_id") @db.Char(36)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt    DateTime @map("expires_at") @db.DateTime(3)

  consumedAt           DateTime? @map("consumed_at") @db.DateTime(3)
  consumedInvitationId String?   @map("consumed_invitation_id") @db.Char(36)
  revokedAt            DateTime? @map("revoked_at") @db.DateTime(3)
  revokedById          String?   @map("revoked_by_id") @db.Char(36)
  revokeReason         String?   @map("revoke_reason") @db.VarChar(300)

  clinic      Clinic       @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  invitations Invitation[]

  @@index([clinicId, status])
  @@map("provisioning_records")
}

/// Recuperación de contraseña: token de un solo uso (solo su SHA-256), vida corta, una pendiente por
/// usuario. Al usarla se invalidan todas las sesiones del usuario. La solicitud siempre responde de
/// forma neutral: que exista o no la cuenta no se revela.
model PasswordRecovery {
  id               String                 @id @default(uuid()) @db.Char(36)
  userId           String                 @map("user_id") @db.Char(36)
  tokenHash        String                 @unique @map("token_hash") @db.Char(64)
  status           PasswordRecoveryStatus @default(PENDING)
  /// user_id mientras esté PENDING: una sola recuperación pendiente por usuario.
  pendingKey       String?                @unique @map("pending_key") @db.Char(36)
  expiresAt        DateTime               @map("expires_at") @db.DateTime(3)
  createdAt        DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  requestIp        String?                @map("request_ip") @db.VarChar(64)
  requestUserAgent String?                @map("request_user_agent") @db.VarChar(255)

  deliveryStatus    DeliveryStatus @default(PENDING) @map("delivery_status")
  deliveryAttempts  Int            @default(0) @map("delivery_attempts")
  lastDeliveryAt    DateTime?      @map("last_delivery_at") @db.DateTime(3)
  lastDeliveryError String?        @map("last_delivery_error") @db.VarChar(120)

  usedAt        DateTime? @map("used_at") @db.DateTime(3)
  usedIp        String?   @map("used_ip") @db.VarChar(64)
  revokedAt     DateTime? @map("revoked_at") @db.DateTime(3)
  revokedReason String?   @map("revoked_reason") @db.VarChar(120)
  expiredAt     DateTime? @map("expired_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("password_recoveries")
}

// ---------------------------------------------------------------------------
// Sub-incremento 3.1: relación asistencial y autorización de lectura clínica.
// NO hay datos clínicos todavía (antecedentes, diagnósticos, evoluciones...): solo el control de acceso.
// ---------------------------------------------------------------------------

/// Origen de la relación. Solo ASSIGNMENT se crea hoy; APPOINTMENT y VISIT se reservan para la agenda y
/// las visitas (la API rechaza crearlas hasta que existan esos módulos).
enum CareRelationshipSource {
  ASSIGNMENT
  APPOINTMENT
  VISIT
}

enum CareRelationshipStatus {
  ACTIVE
  ENDED
}

enum CareRelationshipEndKind {
  REVOKED
  EXPIRED
  SYSTEM
}

enum ClinicalAccessCategory {
  CONTINUITY_OF_CARE
  QUALITY_AUDIT
  LEGAL_REQUEST
  OTHER
}

/// Relación asistencial paciente–odontólogo–clínica. Es explícita: sin una vigente no hay acceso clínico
/// del odontólogo ni vista de apoyo del asistente. El paciente y la sede se atan a la clínica con FK
/// compuestas, así que la base de datos impide cruzar clínicas. Nunca se borra; termina (ENDED) con motivo.
model PatientCareRelationship {
  id            String                   @id @default(uuid()) @db.Char(36)
  clinicId      String                   @map("clinic_id") @db.Char(36)
  patientId     String                   @map("patient_id") @db.Char(36)
  dentistUserId String                   @map("dentist_user_id") @db.Char(36)
  /// Alcance: nulo = toda la clínica; con sede = relación originada en esa sede (la escritura clínica exige esa sede).
  branchId      String?                  @map("branch_id") @db.Char(36)
  source        CareRelationshipSource
  /// Id de la cita o visita que la origina (módulos futuros).
  sourceRef     String?                  @map("source_ref") @db.VarChar(36)
  status        CareRelationshipStatus   @default(ACTIVE)
  /// "paciente|odontólogo|sede-o-*" mientras esté ACTIVE (una vigente por combinación); NULL al terminar.
  activeKey     String?                  @unique @map("active_key") @db.VarChar(120)
  startedAt     DateTime                 @default(now()) @map("started_at") @db.DateTime(3)
  /// Vigencia opcional (p. ej. la de una cita); pasada esa fecha deja de otorgar acceso aunque siga ACTIVE.
  validUntil    DateTime?                @map("valid_until") @db.DateTime(3)
  reason        String?                  @db.VarChar(300)
  createdById   String                   @map("created_by_id") @db.Char(36)
  endedAt       DateTime?                @map("ended_at") @db.DateTime(3)
  endedById     String?                  @map("ended_by_id") @db.Char(36)
  endKind       CareRelationshipEndKind? @map("end_kind")
  endReason     String?                  @map("end_reason") @db.VarChar(300)

  patient Patient @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  branch  Branch? @relation(fields: [branchId, clinicId], references: [id, clinicId], onDelete: Restrict)
  dentist User    @relation(fields: [dentistUserId], references: [id], onDelete: Restrict)

  @@index([clinicId, patientId, status])
  @@index([dentistUserId, status])
  @@index([clinicId, status, validUntil])
  @@map("patient_care_relationships")
}

/// Autorización de lectura de `clinical:read_all`: UN paciente, 30 minutos, atada a la sesión que la pidió.
/// Solo se inserta (triggers bloquean UPDATE y DELETE). Es evidencia: la depuración nunca la toca.
model ClinicalAccessGrant {
  id        String                 @id @default(uuid()) @db.Char(36)
  clinicId  String                 @map("clinic_id") @db.Char(36)
  patientId String                 @map("patient_id") @db.Char(36)
  userId    String                 @map("user_id") @db.Char(36)
  /// Sesión que la solicitó (sin FK a propósito: las sesiones se depuran y la evidencia no debe perderse).
  sessionId String                 @map("session_id") @db.Char(36)
  category  ClinicalAccessCategory
  reason    String                 @db.VarChar(500)
  grantedAt DateTime               @default(now()) @map("granted_at") @db.DateTime(3)
  expiresAt DateTime               @map("expires_at") @db.DateTime(3)
  ip        String?                @db.VarChar(64)
  userAgent String?                @map("user_agent") @db.VarChar(255)

  patient Patient @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, patientId, expiresAt])
  @@index([clinicId, grantedAt])
  @@map("clinical_access_grants")
}

// ---------------------------------------------------------------------------
// Sub-incremento 3.2: antecedentes, alergias y alertas clínicas (versionados).
// Patrón "elemento versionado": una fila por versión; una sola vigente por elemento (current_key único).
// Los triggers solo permiten un UPDATE (soltar current_key al ser reemplazada), nunca DELETE: el historial
// de correcciones, rectificaciones y desactivaciones se conserva siempre. Los valores son TEXTO
// ESTRUCTURADO de apoyo administrativo: no son un catálogo ni una guía médica.
// ---------------------------------------------------------------------------

enum ClinicalEntryKind {
  BACKGROUND
  ALLERGY
}

/// Gravedad referencial declarada por el profesional (no calculada ni normativa).
enum ClinicalSeverity {
  NOT_SPECIFIED
  MILD
  MODERATE
  SEVERE
}

enum ClinicalRecordStatus {
  ACTIVE
  INACTIVE
  ENTERED_IN_ERROR
}

enum ClinicalInfoSource {
  PATIENT
  GUARDIAN
  DOCUMENT
  PROFESSIONAL
  OTHER
}

enum ClinicalChangeKind {
  CREATED
  CORRECTED
  RECTIFIED
  DEACTIVATED
  REACTIVATED
  MARKED_IN_ERROR
}

enum ClinicalAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

/// Antecedente médico o alergia (una versión). `is_critical` genera una alerta derivada mientras esté vigente y activa.
model ClinicalHistoryEntry {
  id            String               @id @default(uuid()) @db.Char(36)
  clinicId      String               @map("clinic_id") @db.Char(36)
  patientId     String               @map("patient_id") @db.Char(36)
  /// Identificador estable del elemento a través de sus versiones.
  itemId        String               @map("item_id") @db.Char(36)
  version       Int
  supersedesId  String?              @map("supersedes_id") @db.Char(36)
  /// = item_id en la versión vigente; NULL en las reemplazadas (índice único => una sola vigente).
  currentKey    String?              @unique @map("current_key") @db.Char(36)
  kind          ClinicalEntryKind
  /// Antecedente o agente alérgeno, en texto libre estructurado.
  label         String               @db.VarChar(200)
  /// Condición o reacción.
  condition     String?              @db.VarChar(300)
  /// Etiqueta de agrupación libre (sin catálogo rígido).
  category      String?              @db.VarChar(60)
  severity      ClinicalSeverity     @default(NOT_SPECIFIED)
  status        ClinicalRecordStatus @default(ACTIVE)
  isCritical    Boolean              @default(false) @map("is_critical")
  onsetDate     DateTime?            @map("onset_date") @db.Date
  source        ClinicalInfoSource
  observations  String?              @db.VarChar(1000)
  changeKind    ClinicalChangeKind   @map("change_kind")
  changeReason  String               @map("change_reason") @db.VarChar(300)
  /// Solo NOMBRES de campos modificados respecto de la versión anterior (nunca valores).
  changedFields Json?                @map("changed_fields")
  createdById   String               @map("created_by_id") @db.Char(36)
  createdAt     DateTime             @default(now()) @map("created_at") @db.DateTime(3)

  patient Patient @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@unique([itemId, version])
  @@index([clinicId, patientId, currentKey])
  @@index([clinicId, patientId, kind, status])
  @@map("clinical_history_entries")
}

/// Alerta clínica MANUAL (una versión). Las derivadas de alergias/antecedentes críticos no se almacenan.
/// Una alerta es informativa: no decide ni bloquea tratamientos.
model ClinicalAlert {
  id            String                @id @default(uuid()) @db.Char(36)
  clinicId      String                @map("clinic_id") @db.Char(36)
  patientId     String                @map("patient_id") @db.Char(36)
  itemId        String                @map("item_id") @db.Char(36)
  version       Int
  supersedesId  String?               @map("supersedes_id") @db.Char(36)
  currentKey    String?               @unique @map("current_key") @db.Char(36)
  severity      ClinicalAlertSeverity
  /// Texto breve visible también para el asistente (sin notas extensas).
  text          String                @db.VarChar(300)
  source        ClinicalInfoSource
  status        ClinicalRecordStatus  @default(ACTIVE)
  /// Vigencia: pasada esta fecha la alerta deja de mostrarse (sigue en el historial).
  expiresAt     DateTime?             @map("expires_at") @db.DateTime(3)
  changeKind    ClinicalChangeKind    @map("change_kind")
  changeReason  String                @map("change_reason") @db.VarChar(300)
  changedFields Json?                 @map("changed_fields")
  createdById   String                @map("created_by_id") @db.Char(36)
  createdAt     DateTime              @default(now()) @map("created_at") @db.DateTime(3)

  patient Patient @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@unique([itemId, version])
  @@index([clinicId, patientId, currentKey])
  @@map("clinical_alerts")
}
