// Fundación multiclínica y acceso (incremento 1).
// Convención: tablas y columnas en snake_case (@@map/@map), ids UUID (CHAR(36)).
// Sin tablas clínicas, de agenda, pagos ni integraciones todavía.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

enum ClinicStatus {
  ACTIVE
  INACTIVE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AssignmentStatus {
  ACTIVE
  INACTIVE
}

/// Alcance del rol: PLATFORM = operación de la plataforma (sin clínica);
/// CLINIC = rol que siempre se ejerce dentro de una clínica concreta.
enum RoleScope {
  PLATFORM
  CLINIC
}

model Clinic {
  id                  String       @id @default(uuid()) @db.Char(36)
  name                String       @db.VarChar(160)
  legalName           String?      @map("legal_name") @db.VarChar(200)
  /// RUC opcional; único cuando existe (MySQL admite varios NULL en un índice único).
  ruc                 String?      @unique @db.VarChar(11)
  /// Branding básico configurable por clínica.
  brandDisplayName    String?      @map("brand_display_name") @db.VarChar(120)
  brandLogoUrl        String?      @map("brand_logo_url") @db.VarChar(500)
  brandPrimaryColor   String?      @map("brand_primary_color") @db.VarChar(9)
  brandSecondaryColor String?      @map("brand_secondary_color") @db.VarChar(9)
  status              ClinicStatus @default(ACTIVE)
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  branches             Branch[]
  assignments          UserAssignment[]
  patients             Patient[]
  invitations          Invitation[]
  provisioningRecords  ProvisioningRecord[]
  procedureDefinitions ProcedureDefinition[]
  rooms                Room[]
  specialties          Specialty[]
  agendaServices       AgendaService[]
  products             Product[]

  @@map("clinics")
}

model Branch {
  id        String       @id @default(uuid()) @db.Char(36)
  clinicId  String       @map("clinic_id") @db.Char(36)
  name      String       @db.VarChar(160)
  address   String?      @db.VarChar(300)
  status    BranchStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  clinic            Clinic                    @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  assignments       UserAssignment[]
  invitations       Invitation[]
  careRelationships PatientCareRelationship[]
  visits            ClinicalVisit[]
  rooms             Room[]
  appointments      Appointment[]
  bookingRequests   BookingRequest[]

  @@unique([clinicId, name])
  // Permite la clave foránea compuesta (branch_id, clinic_id) desde user_assignments,
  // que garantiza en BD que una sede pertenece a la clínica de la asignación.
  @@unique([id, clinicId])
  @@map("branches")
}

model User {
  id                  String     @id @default(uuid()) @db.Char(36)
  /// Siempre en minúsculas (se normaliza en la aplicación).
  email               String     @unique @db.VarChar(254)
  passwordHash        String     @map("password_hash") @db.VarChar(255)
  firstName           String     @map("first_name") @db.VarChar(100)
  lastName            String     @map("last_name") @db.VarChar(100)
  status              UserStatus @default(ACTIVE)
  lastLoginAt         DateTime?  @map("last_login_at")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  /// Deshabilitación (nunca se elimina al usuario): quién, cuándo, por qué y si fue la plataforma
  /// (solo la plataforma puede reactivar una cuenta que ella deshabilitó).
  disabledAt          DateTime?  @map("disabled_at") @db.DateTime(3)
  disabledById        String?    @map("disabled_by_id") @db.Char(36)
  disabledReason      String?    @map("disabled_reason") @db.VarChar(300)
  disabledByPlatform  Boolean    @default(false) @map("disabled_by_platform")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  assignments           UserAssignment[]
  sessions              AuthSession[]
  reauthProofs          ReauthProof[]
  passwordRecoveries    PasswordRecovery[]
  externalIdentity      ExternalIdentity?
  careRelationships     PatientCareRelationship[]
  clinicalGrants        ClinicalAccessGrant[]
  visitsAsDentist       ClinicalVisit[]
  appointmentsAsDentist Appointment[]

  @@map("users")
}

model Role {
  id          String    @id @default(uuid()) @db.Char(36)
  /// Código estable usado por el código de la aplicación (p. ej. CLINIC_ADMIN).
  code        String    @unique @db.VarChar(50)
  name        String    @db.VarChar(100)
  scope       RoleScope
  description String?   @db.VarChar(300)

  permissions RolePermission[]
  assignments UserAssignment[]
  invitations Invitation[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Char(36)
  /// Formato modulo:accion, p. ej. branch:read.
  code        String  @unique @db.VarChar(80)
  description String? @db.VarChar(300)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Char(36)
  permissionId String @map("permission_id") @db.Char(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Única fuente de permisos de un usuario: sin asignación activa no hay acceso.
/// - rol PLATFORM  => clinic_id y branch_id nulos.
/// - rol CLINIC    => clinic_id obligatorio; branch_id nulo = toda la clínica,
///                    branch_id informado = solo esa sede.
/// Esas reglas dependen del rol y se validan en la aplicación (AssignmentsService);
/// la BD garantiza que branch_id requiera clinic_id y que la sede pertenezca a la clínica.
model UserAssignment {
  id            String           @id @default(uuid()) @db.Char(36)
  userId        String           @map("user_id") @db.Char(36)
  roleId        String           @map("role_id") @db.Char(36)
  clinicId      String?          @map("clinic_id") @db.Char(36)
  branchId      String?          @map("branch_id") @db.Char(36)
  /// Evita duplicados con columnas NULL: "userId|roleId|clinicId-o-*|branchId-o-*".
  assignmentKey String           @unique @map("assignment_key") @db.VarChar(160)
  /// Quién otorgó el rol (invitó o asignó). Alimenta la separación de funciones: quien otorgó un rol
  /// clínico a una cuenta no puede además asignarle pacientes. Nulo en datos anteriores a 3.1.
  grantedById   String?          @map("granted_by_id") @db.Char(36)
  status        AssignmentStatus @default(ACTIVE)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch Branch? @relation(fields: [branchId, clinicId], references: [id, clinicId], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, status])
  @@index([clinicId, status])
  @@index([branchId])
  @@index([roleId])
  @@map("user_assignments")
}

/// Registro de auditoría inmutable (los triggers de la migración bloquean UPDATE y DELETE).
/// Sin claves foráneas a propósito: el registro debe sobrevivir a cambios en otras tablas.
model AuditLog {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String?  @map("user_id") @db.Char(36)
  clinicId  String?  @map("clinic_id") @db.Char(36)
  branchId  String?  @map("branch_id") @db.Char(36)
  /// Paciente involucrado (si aplica): permite responder "quién accedió a este paciente".
  patientId String?  @map("patient_id") @db.Char(36)
  action    String   @db.VarChar(64)
  entity    String   @db.VarChar(64)
  entityId  String?  @map("entity_id") @db.VarChar(64)
  ip        String?  @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  /// Resumen seguro de cambios: nunca contraseñas, tokens ni datos clínicos.
  summary   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([clinicId, createdAt])
  @@index([patientId, createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Incremento 2: pacientes, contactos, consentimientos y adjuntos privados.
// Datos demográficos y administrativos únicamente: NO hay datos clínicos aquí.
// Nada se elimina físicamente (triggers de la migración bloquean DELETE).
// Todas las tablas hijas llevan clinic_id y una FK compuesta (patient_id, clinic_id)
// que impide a nivel de BD asociar datos de una clínica a un paciente de otra.
// ---------------------------------------------------------------------------

enum PatientStatus {
  ACTIVE
  INACTIVE
}

enum Sex {
  FEMALE
  MALE
  OTHER
}

enum IdentifierType {
  DNI
  CE
  PASSPORT
}

/// Historial de identificadores y contactos: el valor vigente es ACTIVE; los reemplazados quedan SUPERSEDED.
enum RecordStatus {
  ACTIVE
  SUPERSEDED
}

enum ContactType {
  MOBILE
  PHONE
  EMAIL
  ADDRESS
}

enum GuardianRelationship {
  MOTHER
  FATHER
  LEGAL_GUARDIAN
  GRANDPARENT
  SIBLING
  OTHER
}

enum GuardianLinkStatus {
  ACTIVE
  ENDED
}

enum ConsentType {
  CLINICAL
  LOYALTY
  MARKETING
}

enum ConsentStatus {
  GRANTED
  REVOKED
}

enum ConsentGrantedBy {
  PATIENT
  GUARDIAN
}

/// Administrativas (attachment:*) y clínicas (radiografías, fotos, estudios): estas últimas
/// además pasan por el motor de acceso clínico (relación asistencial, auditoría).
enum AttachmentCategory {
  CONSENT
  IDENTITY_DOCUMENT
  OTHER_ADMINISTRATIVE
  XRAY
  CLINICAL_PHOTO
  STUDY
  OTHER_CLINICAL
}

enum PrescriptionStatus {
  ACTIVE
  DELETED
}

enum AttachmentStatus {
  ACTIVE
  REMOVED
}

model Patient {
  id              String        @id @default(uuid()) @db.Char(36)
  clinicId        String        @map("clinic_id") @db.Char(36)
  firstName       String        @map("first_name") @db.VarChar(100)
  lastName        String        @map("last_name") @db.VarChar(100)
  secondLastName  String?       @map("second_last_name") @db.VarChar(100)
  birthDate       DateTime?     @map("birth_date") @db.Date
  sex             Sex?
  status          PatientStatus @default(ACTIVE)
  statusReason    String?       @map("status_reason") @db.VarChar(300)
  /// Sede donde se registró (informativo: el paciente pertenece a la clínica, no a la sede).
  createdBranchId String?       @map("created_branch_id") @db.Char(36)
  createdById     String        @map("created_by_id") @db.Char(36)
  updatedById     String?       @map("updated_by_id") @db.Char(36)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  clinic             Clinic                      @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  identifiers        PatientIdentifier[]
  contacts           PatientContact[]
  guardians          PatientGuardian[]
  consents           PatientConsent[]
  attachments        Attachment[]
  careRelationships  PatientCareRelationship[]
  clinicalGrants     ClinicalAccessGrant[]
  historyEntries     ClinicalHistoryEntry[]
  allergyAssessments ClinicalAllergyAssessment[]
  visits             ClinicalVisit[]
  charges            Charge[]
  diagnoses          ClinicalDiagnosis[]
  procedures         ClinicalProcedure[]
  notes              ClinicalNote[]
  odontograms        ClinicalOdontogram[]
  appointments       Appointment[]
  clinicalAlerts     ClinicalAlert[]
  prescriptions      Prescription[]

  @@unique([id, clinicId])
  @@index([clinicId, lastName, firstName])
  @@index([clinicId, birthDate])
  @@index([clinicId, status])
  @@map("patients")
}

model PatientIdentifier {
  id             String         @id @default(uuid()) @db.Char(36)
  clinicId       String         @map("clinic_id") @db.Char(36)
  patientId      String         @map("patient_id") @db.Char(36)
  type           IdentifierType
  /// Normalizado (DNI: 8 dígitos; CE/pasaporte: alfanumérico en mayúsculas).
  number         String         @db.VarChar(20)
  status         RecordStatus   @default(ACTIVE)
  /// "clinica|tipo|numero" mientras esté ACTIVE, NULL al reemplazarse:
  /// un mismo documento no puede estar vigente en dos pacientes de la clínica.
  activeKey      String?        @unique @map("active_key") @db.VarChar(80)
  /// "paciente|tipo" mientras esté ACTIVE: un paciente tiene un solo identificador vigente por tipo.
  patientTypeKey String?        @unique @map("patient_type_key") @db.VarChar(80)
  changeReason   String?        @map("change_reason") @db.VarChar(300)
  supersededAt   DateTime?      @map("superseded_at")
  createdById    String         @map("created_by_id") @db.Char(36)
  createdAt      DateTime       @default(now()) @map("created_at")

  patient Patient @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@index([patientId])
  @@index([clinicId, number])
  @@map("patient_identifiers")
}

/// Celular y correo NO son únicos (se comparten entre familiares y cambian): solo alimentan
/// las advertencias de posible duplicado.
model PatientContact {
  id           String       @id @default(uuid()) @db.Char(36)
  clinicId     String       @map("clinic_id") @db.Char(36)
  patientId    String       @map("patient_id") @db.Char(36)
  type         ContactType
  value        String       @db.VarChar(300)
  /// Valor normalizado para comparar (dígitos / correo en minúsculas). NULL para direcciones.
  valueKey     String?      @map("value_key") @db.VarChar(254)
  label        String?      @db.VarChar(60)
  isPrimary    Boolean      @default(false) @map("is_primary")
  status       RecordStatus @default(ACTIVE)
  /// "paciente|tipo" si es el contacto principal vigente: máximo uno por tipo.
  primaryKey   String?      @unique @map("primary_key") @db.VarChar(80)
  /// "paciente|tipo|valor" mientras esté vigente: sin repetir el mismo valor en un paciente.
  activeKey    String?      @unique @map("active_key") @db.VarChar(300)
  changeReason String?      @map("change_reason") @db.VarChar(300)
  supersededAt DateTime?    @map("superseded_at")
  createdById  String       @map("created_by_id") @db.Char(36)
  createdAt    DateTime     @default(now()) @map("created_at")

  patient Patient @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@index([patientId, status])
  @@index([clinicId, type, valueKey])
  @@map("patient_contacts")
}

/// Representante o apoderado (persona). Puede serlo de varios pacientes (hermanos).
model Guardian {
  id               String          @id @default(uuid()) @db.Char(36)
  clinicId         String          @map("clinic_id") @db.Char(36)
  firstName        String          @map("first_name") @db.VarChar(100)
  lastName         String          @map("last_name") @db.VarChar(100)
  secondLastName   String?         @map("second_last_name") @db.VarChar(100)
  identifierType   IdentifierType? @map("identifier_type")
  identifierNumber String?         @map("identifier_number") @db.VarChar(20)
  mobile           String?         @db.VarChar(20)
  email            String?         @db.VarChar(254)
  createdById      String          @map("created_by_id") @db.Char(36)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  links PatientGuardian[]

  @@unique([id, clinicId])
  @@index([clinicId, lastName])
  @@index([clinicId, identifierNumber])
  @@map("guardians")
}

model PatientGuardian {
  id                    String               @id @default(uuid()) @db.Char(36)
  clinicId              String               @map("clinic_id") @db.Char(36)
  patientId             String               @map("patient_id") @db.Char(36)
  guardianId            String               @map("guardian_id") @db.Char(36)
  relationship          GuardianRelationship
  isPrimary             Boolean              @default(false) @map("is_primary")
  isLegalRepresentative Boolean              @default(false) @map("is_legal_representative")
  status                GuardianLinkStatus   @default(ACTIVE)
  /// "paciente|apoderado" mientras esté vigente: sin vínculos duplicados.
  activeKey             String?              @unique @map("active_key") @db.VarChar(80)
  endedAt               DateTime?            @map("ended_at")
  endReason             String?              @map("end_reason") @db.VarChar(300)
  createdById           String               @map("created_by_id") @db.Char(36)
  createdAt             DateTime             @default(now()) @map("created_at")

  patient  Patient  @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  guardian Guardian @relation(fields: [guardianId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@index([patientId, status])
  @@index([guardianId])
  @@map("patient_guardians")
}

/// Un consentimiento es un registro independiente; revocar no lo borra ni lo edita.
/// Tipos separados: clínico, fidelización y marketing. Validez legal y formatos: por validar.
model PatientConsent {
  id               String           @id @default(uuid()) @db.Char(36)
  clinicId         String           @map("clinic_id") @db.Char(36)
  patientId        String           @map("patient_id") @db.Char(36)
  type             ConsentType
  status           ConsentStatus    @default(GRANTED)
  documentTitle    String           @map("document_title") @db.VarChar(200)
  documentVersion  String           @map("document_version") @db.VarChar(60)
  grantedAt        DateTime         @map("granted_at") @db.DateTime(3)
  grantedBy        ConsentGrantedBy @map("granted_by")
  guardianId       String?          @map("guardian_id") @db.Char(36)
  notes            String?          @db.VarChar(500)
  /// "paciente|tipo" mientras esté GRANTED: un solo consentimiento vigente por tipo.
  activeKey        String?          @unique @map("active_key") @db.VarChar(80)
  revokedAt        DateTime?        @map("revoked_at") @db.DateTime(3)
  revokedById      String?          @map("revoked_by_id") @db.Char(36)
  revocationReason String?          @map("revocation_reason") @db.VarChar(300)
  createdById      String           @map("created_by_id") @db.Char(36)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  patient     Patient      @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  attachments Attachment[]

  @@index([patientId, type])
  @@index([clinicId, type, status])
  @@map("patient_consents")
}

/// Metadatos de un archivo. El contenido vive en disco privado (jamás en MySQL) bajo
/// storage_key, que nunca se expone por la API; el acceso es solo por endpoints autorizados.
model Attachment {
  id            String             @id @default(uuid()) @db.Char(36)
  clinicId      String             @map("clinic_id") @db.Char(36)
  patientId     String             @map("patient_id") @db.Char(36)
  consentId     String?            @map("consent_id") @db.Char(36)
  category      AttachmentCategory
  originalName  String             @map("original_name") @db.VarChar(160)
  /// MIME detectado por contenido (no el declarado por el cliente).
  mimeType      String             @map("mime_type") @db.VarChar(100)
  sizeBytes     Int                @map("size_bytes")
  sha256        String             @db.Char(64)
  storageKey    String             @unique @map("storage_key") @db.VarChar(120)
  description   String?            @db.VarChar(300)
  status        AttachmentStatus   @default(ACTIVE)
  removedAt     DateTime?          @map("removed_at")
  removedById   String?            @map("removed_by_id") @db.Char(36)
  removalReason String?            @map("removal_reason") @db.VarChar(300)
  uploadedById  String             @map("uploaded_by_id") @db.Char(36)
  createdAt     DateTime           @default(now()) @map("created_at")

  patient Patient         @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  consent PatientConsent? @relation(fields: [consentId], references: [id], onDelete: Restrict)

  @@index([patientId, status])
  @@index([consentId])
  @@index([clinicId, sha256])
  @@map("attachments")
}

/// Receta médica del paciente. Puede emitirse dentro de una atención (visitId) o por fuera de ella.
/// Editable mientras esté ACTIVE; "eliminar" es baja lógica con motivo (el registro se conserva).
model Prescription {
  id            String             @id @default(uuid()) @db.Char(36)
  clinicId      String             @map("clinic_id") @db.Char(36)
  patientId     String             @map("patient_id") @db.Char(36)
  visitId       String?            @map("visit_id") @db.Char(36)
  /// Correlativo por clínica, visible en el PDF (RX-000001).
  number        Int
  prescriberId  String             @map("prescriber_id") @db.Char(36)
  diagnosis     String?            @db.VarChar(300)
  notes         String?            @db.VarChar(1000)
  status        PrescriptionStatus @default(ACTIVE)
  deletedAt     DateTime?          @map("deleted_at")
  deletedById   String?            @map("deleted_by_id") @db.Char(36)
  deleteReason  String?            @map("delete_reason") @db.VarChar(300)
  lastEmailedAt DateTime?          @map("last_emailed_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  patient Patient            @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  items   PrescriptionItem[]

  @@unique([clinicId, number])
  @@index([patientId, status, createdAt])
  @@index([clinicId, prescriberId, createdAt])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String  @id @default(uuid()) @db.Char(36)
  prescriptionId String  @map("prescription_id") @db.Char(36)
  position       Int
  medication     String  @db.VarChar(200)
  dose           String? @db.VarChar(120)
  frequency      String? @db.VarChar(120)
  duration       String? @db.VarChar(120)
  instructions   String? @db.VarChar(300)

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId, position])
  @@map("prescription_items")
}

// ---------------------------------------------------------------------------
// Caja chica: libro de movimientos por caja (una por sede) y por cuenta o medio de pago.
// El saldo de una cuenta es la suma de sus movimientos vigentes; la apertura y el arqueo
// generan ajustes automáticos (kind OPENING / COUNT_ADJUSTMENT) para que el libro siempre cuadre.
// ---------------------------------------------------------------------------

enum CashAccountKind {
  CASH
  CARD
  YAPE_PLIN
  TRANSFER
  OTHER
}

enum CashFlow {
  INCOME
  EXPENSE
}

enum CashMovementKind {
  NORMAL
  OPENING
  COUNT_ADJUSTMENT
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementStatus {
  ACTIVE
  VOIDED
}

/// Cuenta o medio de pago de la clínica (Efectivo, Yape/Plin, una cuenta bancaria…). Se desactiva, no se borra.
model CashAccount {
  id            String          @id @default(uuid()) @db.Char(36)
  clinicId      String          @map("clinic_id") @db.Char(36)
  name          String          @db.VarChar(80)
  kind          CashAccountKind
  /// Si es falso, un egreso no puede dejar el saldo de la cuenta por debajo de cero.
  allowNegative Boolean         @default(false) @map("allow_negative")
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now()) @map("created_at") @db.DateTime(3)

  movements CashMovement[]
  sessions  CashSessionAccount[]

  @@unique([clinicId, name])
  @@map("cash_accounts")
}

/// Tipo de operación configurable (categoría de ingreso o de egreso).
model CashCategory {
  id        String   @id @default(uuid()) @db.Char(36)
  clinicId  String   @map("clinic_id") @db.Char(36)
  flow      CashFlow
  name      String   @db.VarChar(80)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  movements CashMovement[]

  @@unique([clinicId, flow, name])
  @@map("cash_categories")
}

/// Caja de una sede (una por sede, se crea al abrir por primera vez).
model CashRegister {
  id        String   @id @default(uuid()) @db.Char(36)
  clinicId  String   @map("clinic_id") @db.Char(36)
  branchId  String   @map("branch_id") @db.Char(36)
  name      String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  sessions  CashSession[]
  movements CashMovement[]

  @@unique([branchId])
  @@index([clinicId])
  @@map("cash_registers")
}

/// Turno de caja: apertura y cierre con conciliación. Solo uno abierto por caja (open_key).
model CashSession {
  id         String            @id @default(uuid()) @db.Char(36)
  clinicId   String            @map("clinic_id") @db.Char(36)
  registerId String            @map("register_id") @db.Char(36)
  status     CashSessionStatus @default(OPEN)
  /// = registerId mientras esté abierta; NULL al cerrar. Impide dos aperturas simultáneas.
  openKey    String?           @unique @map("open_key") @db.Char(36)
  openedAt   DateTime          @default(now()) @map("opened_at") @db.DateTime(3)
  openedById String            @map("opened_by_id") @db.Char(36)
  openNotes  String?           @map("open_notes") @db.VarChar(300)
  closedAt   DateTime?         @map("closed_at") @db.DateTime(3)
  closedById String?           @map("closed_by_id") @db.Char(36)
  closeNotes String?           @map("close_notes") @db.VarChar(300)
  /// Se incrementa en cada escritura de la caja: serializa los movimientos concurrentes.
  version    Int               @default(1)

  register  CashRegister         @relation(fields: [registerId], references: [id], onDelete: Restrict)
  accounts  CashSessionAccount[]
  movements CashMovement[]

  @@index([registerId, openedAt])
  @@map("cash_sessions")
}

model CashSessionAccount {
  id              String @id @default(uuid()) @db.Char(36)
  sessionId       String @map("session_id") @db.Char(36)
  accountId       String @map("account_id") @db.Char(36)
  openingCents    Int    @map("opening_cents")
  expectedCents   Int?   @map("expected_cents")
  countedCents    Int?   @map("counted_cents")
  differenceCents Int?   @map("difference_cents")

  session CashSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  account CashAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([sessionId, accountId])
  @@map("cash_session_accounts")
}

model CashMovement {
  id              String             @id @default(uuid()) @db.Char(36)
  clinicId        String             @map("clinic_id") @db.Char(36)
  registerId      String             @map("register_id") @db.Char(36)
  sessionId       String             @map("session_id") @db.Char(36)
  accountId       String             @map("account_id") @db.Char(36)
  categoryId      String?            @map("category_id") @db.Char(36)
  flow            CashFlow
  kind            CashMovementKind   @default(NORMAL)
  description     String             @db.VarChar(200)
  operationNumber String?            @map("operation_number") @db.VarChar(40)
  /// Siempre positivo; el signo lo da `flow`.
  amountCents     Int                @map("amount_cents")
  occurredAt      DateTime           @map("occurred_at") @db.DateTime(3)
  createdById     String             @map("created_by_id") @db.Char(36)
  createdAt       DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  status          CashMovementStatus @default(ACTIVE)
  voidedAt        DateTime?          @map("voided_at") @db.DateTime(3)
  voidedById      String?            @map("voided_by_id") @db.Char(36)
  voidReason      String?            @map("void_reason") @db.VarChar(300)
  /// Clave de idempotencia del formulario: reenviar el mismo envío nunca duplica el movimiento.
  requestKey      String?            @map("request_key") @db.Char(36)
  /// "cuenta|número" mientras esté vigente: un mismo número de operación no se registra dos veces en la cuenta.
  operationKey    String?            @unique @map("operation_key") @db.VarChar(130)

  register CashRegister  @relation(fields: [registerId], references: [id], onDelete: Restrict)
  session  CashSession   @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  account  CashAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category CashCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([clinicId, requestKey])
  @@index([registerId, status, occurredAt])
  @@index([sessionId])
  @@index([registerId, accountId, status])
  @@map("cash_movements")
}

// ---------------------------------------------------------------------------
// Incremento 3.0: sesiones con refresh token, reautenticación, invitaciones y
// aprovisionamiento formal. NINGÚN secreto se guarda en claro: solo su SHA-256.
// ---------------------------------------------------------------------------

enum SessionRevokeReason {
  LOGOUT
  LOGOUT_ALL
  REUSE_DETECTED
  EXPIRED
  USER_DISABLED
  PASSWORD_RESET
}

enum RefreshTokenStatus {
  ACTIVE
  ROTATED
  REVOKED
}

/// Propósitos de la prueba de reautenticación. Los clínicos están reservados para los
/// siguientes sub-incrementos; hoy solo AUTHORIZE_DIRECTOR_PROVISIONING tiene consumidor.
/// Una reautenticación NO es una firma digital, legal ni clínica.
enum ReauthPurpose {
  CLOSE_CLINICAL_NOTE
  CORRECT_CLINICAL_NOTE
  MARK_CLINICAL_NOTE_ERROR
  CLINICAL_READ_ALL
  AUTHORIZE_DIRECTOR_PROVISIONING
  CORRECT_ODONTOGRAM
  MARK_ODONTOGRAM_ERROR
}

enum PasswordRecoveryStatus {
  PENDING
  USED
  REVOKED
  EXPIRED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum ProvisioningKind {
  FIRST_CLINICAL_DIRECTOR
}

enum ProvisioningStatus {
  ACTIVE
  CONSUMED
  REVOKED
  EXPIRED
}

/// Una sesión es la "familia" de sus refresh tokens: si se detecta la reutilización de uno ya
/// rotado, se revoca la sesión completa. El access token lleva el id de sesión (sid) y deja de
/// valer en cuanto la sesión se revoca.
model AuthSession {
  id                String               @id @default(uuid()) @db.Char(36)
  userId            String               @map("user_id") @db.Char(36)
  createdAt         DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  lastUsedAt        DateTime             @default(now()) @map("last_used_at") @db.DateTime(3)
  /// Tope absoluto de la sesión, aunque se siga renovando.
  absoluteExpiresAt DateTime             @map("absolute_expires_at") @db.DateTime(3)
  revokedAt         DateTime?            @map("revoked_at") @db.DateTime(3)
  revokedReason     SessionRevokeReason? @map("revoked_reason")
  ip                String?              @db.VarChar(64)
  userAgent         String?              @map("user_agent") @db.VarChar(255)
  /// Último contexto activo, para restaurarlo al renovar el access token.
  contextSet        Boolean              @default(false) @map("context_set")
  contextClinicId   String?              @map("context_clinic_id") @db.Char(36)
  contextBranchId   String?              @map("context_branch_id") @db.Char(36)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  reauthProofs  ReauthProof[]

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id           String             @id @default(uuid()) @db.Char(36)
  sessionId    String             @map("session_id") @db.Char(36)
  /// SHA-256 (hex) del token. El token en claro solo existe en la cookie del cliente.
  tokenHash    String             @unique @map("token_hash") @db.Char(64)
  status       RefreshTokenStatus @default(ACTIVE)
  createdAt    DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt    DateTime           @map("expires_at") @db.DateTime(3)
  rotatedAt    DateTime?          @map("rotated_at") @db.DateTime(3)
  replacedById String?            @map("replaced_by_id") @db.Char(36)

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@map("refresh_tokens")
}

/// Prueba de reautenticación: vida corta, un solo uso, ligada a usuario, sesión, propósito y objetivo.
model ReauthProof {
  id        String        @id @default(uuid()) @db.Char(36)
  userId    String        @map("user_id") @db.Char(36)
  sessionId String        @map("session_id") @db.Char(36)
  purpose   ReauthPurpose
  /// Objeto sobre el que se autoriza (p. ej. la clínica o la nota); NULL si no aplica.
  targetId  String?       @map("target_id") @db.VarChar(64)
  tokenHash String        @unique @map("token_hash") @db.Char(64)
  createdAt DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt DateTime      @map("expires_at") @db.DateTime(3)
  usedAt    DateTime?     @map("used_at") @db.DateTime(3)
  ip        String?       @db.VarChar(64)

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("reauth_proofs")
}

/// Invitación de un solo uso. El token viaja solo por el canal de entrega; aquí solo su hash.
/// Aceptarla crea (o enlaza) al usuario con una asignación; nunca fija la contraseña de otra persona.
model Invitation {
  id               String           @id @default(uuid()) @db.Char(36)
  email            String           @db.VarChar(254)
  roleId           String           @map("role_id") @db.Char(36)
  clinicId         String?          @map("clinic_id") @db.Char(36)
  branchId         String?          @map("branch_id") @db.Char(36)
  tokenHash        String           @unique @map("token_hash") @db.Char(64)
  status           InvitationStatus @default(PENDING)
  /// "email|rol|clínica|sede" mientras esté PENDING: sin invitaciones pendientes duplicadas.
  pendingKey       String?          @unique @map("pending_key") @db.VarChar(400)
  expiresAt        DateTime         @map("expires_at") @db.DateTime(3)
  createdById      String           @map("created_by_id") @db.Char(36)
  createdAt        DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  /// true si la emitió la plataforma (solo para el primer CLINIC_ADMIN): al aceptarse se vuelve a
  /// comprobar que la clínica siga sin administrador, para que la plataforma no pueda infiltrarse después.
  issuedByPlatform Boolean          @default(false) @map("issued_by_platform")

  deliveryStatus    DeliveryStatus @default(PENDING) @map("delivery_status")
  deliveryAttempts  Int            @default(0) @map("delivery_attempts")
  lastDeliveryAt    DateTime?      @map("last_delivery_at") @db.DateTime(3)
  /// Motivo genérico y saneado (nunca la URL, el token ni la respuesta del canal).
  lastDeliveryError String?        @map("last_delivery_error") @db.VarChar(120)
  tokenRotatedAt    DateTime?      @map("token_rotated_at") @db.DateTime(3)

  acceptedAt     DateTime? @map("accepted_at") @db.DateTime(3)
  acceptedUserId String?   @map("accepted_user_id") @db.Char(36)
  revokedAt      DateTime? @map("revoked_at") @db.DateTime(3)
  revokedById    String?   @map("revoked_by_id") @db.Char(36)
  revokeReason   String?   @map("revoke_reason") @db.VarChar(300)
  expiredAt      DateTime? @map("expired_at") @db.DateTime(3)

  /// Solo para la invitación del primer Director Clínico.
  provisioningRecordId String? @map("provisioning_record_id") @db.Char(36)

  role               Role                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  clinic             Clinic?             @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch             Branch?             @relation(fields: [branchId, clinicId], references: [id, clinicId], onDelete: Restrict, onUpdate: Restrict)
  provisioningRecord ProvisioningRecord? @relation(fields: [provisioningRecordId], references: [id], onDelete: Restrict)

  @@index([clinicId, status])
  @@index([email])
  @@index([status, expiresAt])
  @@map("invitations")
}

/// Registro formal de aprovisionamiento autorizado por la clínica (primer Director Clínico).
/// LIMITACIÓN: sin firma ni flujo contractual integrado, es una declaración asentada por el
/// administrador de la clínica; el sistema NO verifica la autenticidad del documento citado.
model ProvisioningRecord {
  id        String             @id @default(uuid()) @db.Char(36)
  clinicId  String             @map("clinic_id") @db.Char(36)
  kind      ProvisioningKind
  status    ProvisioningStatus @default(ACTIVE)
  /// "clínica|tipo" mientras esté ACTIVE: un solo registro vigente por clínica y tipo.
  activeKey String?            @unique @map("active_key") @db.VarChar(80)

  designeeName  String @map("designee_name") @db.VarChar(200)
  /// La invitación del Director debe dirigirse exactamente a este correo.
  designeeEmail String @map("designee_email") @db.VarChar(254)

  authorizedByName           String   @map("authorized_by_name") @db.VarChar(200)
  authorizedByPosition       String   @map("authorized_by_position") @db.VarChar(120)
  authorizedByDocumentType   String   @map("authorized_by_document_type") @db.VarChar(10)
  authorizedByDocumentNumber String   @map("authorized_by_document_number") @db.VarChar(20)
  authorizationReference     String   @map("authorization_reference") @db.VarChar(200)
  authorizationDate          DateTime @map("authorization_date") @db.Date
  notes                      String?  @db.VarChar(500)

  recordedById String   @map("recorded_by_id") @db.Char(36)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt    DateTime @map("expires_at") @db.DateTime(3)

  consumedAt           DateTime? @map("consumed_at") @db.DateTime(3)
  consumedInvitationId String?   @map("consumed_invitation_id") @db.Char(36)
  revokedAt            DateTime? @map("revoked_at") @db.DateTime(3)
  revokedById          String?   @map("revoked_by_id") @db.Char(36)
  revokeReason         String?   @map("revoke_reason") @db.VarChar(300)

  clinic      Clinic       @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  invitations Invitation[]

  @@index([clinicId, status])
  @@map("provisioning_records")
}

/// Recuperación de contraseña: token de un solo uso (solo su SHA-256), vida corta, una pendiente por
/// usuario. Al usarla se invalidan todas las sesiones del usuario. La solicitud siempre responde de
/// forma neutral: que exista o no la cuenta no se revela.
model PasswordRecovery {
  id               String                 @id @default(uuid()) @db.Char(36)
  userId           String                 @map("user_id") @db.Char(36)
  tokenHash        String                 @unique @map("token_hash") @db.Char(64)
  status           PasswordRecoveryStatus @default(PENDING)
  /// user_id mientras esté PENDING: una sola recuperación pendiente por usuario.
  pendingKey       String?                @unique @map("pending_key") @db.Char(36)
  expiresAt        DateTime               @map("expires_at") @db.DateTime(3)
  createdAt        DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  requestIp        String?                @map("request_ip") @db.VarChar(64)
  requestUserAgent String?                @map("request_user_agent") @db.VarChar(255)

  deliveryStatus    DeliveryStatus @default(PENDING) @map("delivery_status")
  deliveryAttempts  Int            @default(0) @map("delivery_attempts")
  lastDeliveryAt    DateTime?      @map("last_delivery_at") @db.DateTime(3)
  lastDeliveryError String?        @map("last_delivery_error") @db.VarChar(120)

  usedAt        DateTime? @map("used_at") @db.DateTime(3)
  usedIp        String?   @map("used_ip") @db.VarChar(64)
  revokedAt     DateTime? @map("revoked_at") @db.DateTime(3)
  revokedReason String?   @map("revoked_reason") @db.VarChar(120)
  expiredAt     DateTime? @map("expired_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("password_recoveries")
}

// ---------------------------------------------------------------------------
// Sub-incremento 3.1: relación asistencial y autorización de lectura clínica.
// NO hay datos clínicos todavía (antecedentes, diagnósticos, evoluciones...): solo el control de acceso.
// ---------------------------------------------------------------------------

/// Origen de la relación. Solo ASSIGNMENT se crea hoy; APPOINTMENT y VISIT se reservan para la agenda y
/// las visitas (la API rechaza crearlas hasta que existan esos módulos).
enum CareRelationshipSource {
  ASSIGNMENT
  APPOINTMENT
  VISIT
}

enum CareRelationshipStatus {
  ACTIVE
  ENDED
}

enum CareRelationshipEndKind {
  REVOKED
  EXPIRED
  SYSTEM
}

enum ClinicalAccessCategory {
  CONTINUITY_OF_CARE
  QUALITY_AUDIT
  LEGAL_REQUEST
  OTHER
}

/// Relación asistencial paciente–odontólogo–clínica. Es explícita: sin una vigente no hay acceso clínico
/// del odontólogo ni vista de apoyo del asistente. El paciente y la sede se atan a la clínica con FK
/// compuestas, así que la base de datos impide cruzar clínicas. Nunca se borra; termina (ENDED) con motivo.
model PatientCareRelationship {
  id            String                   @id @default(uuid()) @db.Char(36)
  clinicId      String                   @map("clinic_id") @db.Char(36)
  patientId     String                   @map("patient_id") @db.Char(36)
  dentistUserId String                   @map("dentist_user_id") @db.Char(36)
  /// Alcance: nulo = toda la clínica; con sede = relación originada en esa sede (la escritura clínica exige esa sede).
  branchId      String?                  @map("branch_id") @db.Char(36)
  source        CareRelationshipSource
  /// Id de la cita o visita que la origina (módulos futuros).
  sourceRef     String?                  @map("source_ref") @db.VarChar(36)
  status        CareRelationshipStatus   @default(ACTIVE)
  /// "paciente|odontólogo|sede-o-*" mientras esté ACTIVE (una vigente por combinación); NULL al terminar.
  activeKey     String?                  @unique @map("active_key") @db.VarChar(120)
  startedAt     DateTime                 @default(now()) @map("started_at") @db.DateTime(3)
  /// Vigencia opcional (p. ej. la de una cita); pasada esa fecha deja de otorgar acceso aunque siga ACTIVE.
  validUntil    DateTime?                @map("valid_until") @db.DateTime(3)
  reason        String?                  @db.VarChar(300)
  createdById   String                   @map("created_by_id") @db.Char(36)
  endedAt       DateTime?                @map("ended_at") @db.DateTime(3)
  endedById     String?                  @map("ended_by_id") @db.Char(36)
  endKind       CareRelationshipEndKind? @map("end_kind")
  endReason     String?                  @map("end_reason") @db.VarChar(300)

  patient Patient @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  branch  Branch? @relation(fields: [branchId, clinicId], references: [id, clinicId], onDelete: Restrict)
  dentist User    @relation(fields: [dentistUserId], references: [id], onDelete: Restrict)

  @@index([clinicId, patientId, status])
  @@index([dentistUserId, status])
  @@index([clinicId, status, validUntil])
  @@map("patient_care_relationships")
}

/// Autorización de lectura de `clinical:read_all`: UN paciente, 30 minutos, atada a la sesión que la pidió.
/// Solo se inserta (triggers bloquean UPDATE y DELETE). Es evidencia: la depuración nunca la toca.
model ClinicalAccessGrant {
  id        String                 @id @default(uuid()) @db.Char(36)
  clinicId  String                 @map("clinic_id") @db.Char(36)
  patientId String                 @map("patient_id") @db.Char(36)
  userId    String                 @map("user_id") @db.Char(36)
  /// Sesión que la solicitó (sin FK a propósito: las sesiones se depuran y la evidencia no debe perderse).
  sessionId String                 @map("session_id") @db.Char(36)
  category  ClinicalAccessCategory
  reason    String                 @db.VarChar(500)
  grantedAt DateTime               @default(now()) @map("granted_at") @db.DateTime(3)
  expiresAt DateTime               @map("expires_at") @db.DateTime(3)
  ip        String?                @db.VarChar(64)
  userAgent String?                @map("user_agent") @db.VarChar(255)

  patient Patient @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, patientId, expiresAt])
  @@index([clinicId, grantedAt])
  @@map("clinical_access_grants")
}

// ---------------------------------------------------------------------------
// Sub-incremento 3.2: antecedentes, alergias y alertas clínicas (versionados).
// Patrón "elemento versionado": una fila por versión; una sola vigente por elemento (current_key único).
// Los triggers solo permiten un UPDATE (soltar current_key al ser reemplazada), nunca DELETE: el historial
// de correcciones, rectificaciones y desactivaciones se conserva siempre. Los valores son TEXTO
// ESTRUCTURADO de apoyo administrativo: no son un catálogo ni una guía médica.
// ---------------------------------------------------------------------------

enum ClinicalEntryKind {
  BACKGROUND
  ALLERGY
}

/// Gravedad referencial declarada por el profesional (no calculada ni normativa).
enum ClinicalSeverity {
  NOT_SPECIFIED
  MILD
  MODERATE
  SEVERE
}

enum ClinicalRecordStatus {
  ACTIVE
  INACTIVE
  ENTERED_IN_ERROR
}

enum ClinicalInfoSource {
  PATIENT
  GUARDIAN
  DOCUMENT
  PROFESSIONAL
  OTHER
}

enum ClinicalChangeKind {
  CREATED
  CORRECTED
  RECTIFIED
  DEACTIVATED
  REACTIVATED
  MARKED_IN_ERROR
}

enum ClinicalAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

/// Antecedente médico o alergia (una versión). `is_critical` genera una alerta derivada mientras esté vigente y activa.
model ClinicalHistoryEntry {
  id            String               @id @default(uuid()) @db.Char(36)
  clinicId      String               @map("clinic_id") @db.Char(36)
  patientId     String               @map("patient_id") @db.Char(36)
  /// Identificador estable del elemento a través de sus versiones.
  itemId        String               @map("item_id") @db.Char(36)
  version       Int
  supersedesId  String?              @map("supersedes_id") @db.Char(36)
  /// = item_id en la versión vigente; NULL en las reemplazadas (índice único => una sola vigente).
  currentKey    String?              @unique @map("current_key") @db.Char(36)
  kind          ClinicalEntryKind
  /// Antecedente o agente alérgeno, en texto libre estructurado.
  label         String               @db.VarChar(200)
  /// Condición o reacción.
  condition     String?              @db.VarChar(300)
  /// Etiqueta de agrupación libre (sin catálogo rígido).
  category      String?              @db.VarChar(60)
  severity      ClinicalSeverity     @default(NOT_SPECIFIED)
  status        ClinicalRecordStatus @default(ACTIVE)
  isCritical    Boolean              @default(false) @map("is_critical")
  onsetDate     DateTime?            @map("onset_date") @db.Date
  source        ClinicalInfoSource
  observations  String?              @db.VarChar(1000)
  changeKind    ClinicalChangeKind   @map("change_kind")
  changeReason  String?              @map("change_reason") @db.VarChar(300)
  /// Solo NOMBRES de campos modificados respecto de la versión anterior (nunca valores).
  changedFields Json?                @map("changed_fields")
  createdById   String               @map("created_by_id") @db.Char(36)
  createdAt     DateTime             @default(now()) @map("created_at") @db.DateTime(3)

  patient Patient @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@unique([itemId, version])
  @@index([clinicId, patientId, currentKey])
  @@index([clinicId, patientId, kind, status])
  @@map("clinical_history_entries")
}

/// Alerta clínica MANUAL (una versión). Las derivadas de alergias/antecedentes críticos no se almacenan.
/// Una alerta es informativa: no decide ni bloquea tratamientos.
model ClinicalAlert {
  id            String                @id @default(uuid()) @db.Char(36)
  clinicId      String                @map("clinic_id") @db.Char(36)
  patientId     String                @map("patient_id") @db.Char(36)
  itemId        String                @map("item_id") @db.Char(36)
  version       Int
  supersedesId  String?               @map("supersedes_id") @db.Char(36)
  currentKey    String?               @unique @map("current_key") @db.Char(36)
  severity      ClinicalAlertSeverity
  /// Texto breve visible también para el asistente (sin notas extensas).
  text          String                @db.VarChar(300)
  source        ClinicalInfoSource
  status        ClinicalRecordStatus  @default(ACTIVE)
  /// Vigencia: pasada esta fecha la alerta deja de mostrarse (sigue en el historial).
  expiresAt     DateTime?             @map("expires_at") @db.DateTime(3)
  changeKind    ClinicalChangeKind    @map("change_kind")
  changeReason  String?               @map("change_reason") @db.VarChar(300)
  changedFields Json?                 @map("changed_fields")
  createdById   String                @map("created_by_id") @db.Char(36)
  createdAt     DateTime              @default(now()) @map("created_at") @db.DateTime(3)

  patient Patient @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@unique([itemId, version])
  @@index([clinicId, patientId, currentKey])
  @@map("clinical_alerts")
}

enum AllergyAssessmentStatus {
  NOT_ASKED
  NO_KNOWN_ALLERGIES
  ALLERGIES_RECORDED
}

/// Evaluación de alergias del paciente: estado EXPLÍCITO y versionado (una cadena por paciente; item_id = patient_id).
/// Distingue "no se preguntó" de "se preguntó y no reporta alergias". Invariante (también en la base de datos):
/// ALLERGIES_RECORDED <=> existe al menos una alergia activa vigente. Sin filas = NOT_ASKED (o ALLERGIES_RECORDED derivado
/// si hay alergias anteriores a esta tabla).
model ClinicalAllergyAssessment {
  id           String                  @id @default(uuid()) @db.Char(36)
  clinicId     String                  @map("clinic_id") @db.Char(36)
  patientId    String                  @map("patient_id") @db.Char(36)
  version      Int
  supersedesId String?                 @map("supersedes_id") @db.Char(36)
  /// = patient_id en la versión vigente; NULL en las reemplazadas (único => una sola vigente por paciente).
  currentKey   String?                 @unique @map("current_key") @db.Char(36)
  status       AllergyAssessmentStatus
  /// Fecha en que se consultó al paciente (no futura).
  assessedOn   DateTime                @map("assessed_on") @db.Date
  source       ClinicalInfoSource
  observations String?                 @db.VarChar(500)
  changeKind   ClinicalChangeKind      @map("change_kind")
  /// Obligatorio desde la versión 2; el alta inicial no lo exige.
  changeReason String?                 @map("change_reason") @db.VarChar(300)
  /// true = la versión la generó el sistema al registrar o retirar alergias (no una declaración del profesional).
  automatic    Boolean                 @default(false)
  createdById  String                  @map("created_by_id") @db.Char(36)
  createdAt    DateTime                @default(now()) @map("created_at") @db.DateTime(3)

  patient Patient @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@unique([patientId, version])
  @@index([clinicId, patientId])
  @@map("clinical_allergy_assessments")
}

// ---------------------------------------------------------------------------
// Sub-incremento 3.3: visitas clínicas, diagnósticos y procedimientos realizados.
// Registros de lo que el profesional DECLARA: no son recomendación, protocolo ni decisión clínica automática.
// Diagnósticos y procedimientos son versionados (como los antecedentes): sin DELETE ni reescritura.
// Sin evoluciones narrativas, odontograma, planes, presupuestos, agenda ni facturación.
// ---------------------------------------------------------------------------

enum ProcedureDefinitionStatus {
  ACTIVE
  INACTIVE
}

enum VisitStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum DiagnosisCertainty {
  PRESUMPTIVE
  DEFINITIVE
}

enum ProcedureStatus {
  OPEN
  CLOSED
  CANCELLED
  ENTERED_IN_ERROR
}

enum ProcedureChangeKind {
  CREATED
  CORRECTED
  RECTIFIED
  CLOSED
  CANCELLED
  MARKED_IN_ERROR
}

/// Consentimiento clínico verificado al cerrar el procedimiento (evidencia).
enum ProcedureClosureConsent {
  NOT_REQUIRED
  GRANTED
}

/// Catálogo de procedimientos CONFIGURABLE por clínica. No es un nomenclador ni una guía clínica: cada clínica define los
/// suyos. `requires_clinical_consent` hace que cerrar un procedimiento de este tipo exija consentimiento clínico vigente.
model ProcedureDefinition {
  id                      String                    @id @default(uuid()) @db.Char(36)
  clinicId                String                    @map("clinic_id") @db.Char(36)
  /// Código interno de la clínica (mayúsculas), único dentro de la clínica.
  code                    String                    @db.VarChar(40)
  name                    String                    @db.VarChar(160)
  description             String?                   @db.VarChar(300)
  requiresClinicalConsent Boolean                   @default(false) @map("requires_clinical_consent")
  status                  ProcedureDefinitionStatus @default(ACTIVE)
  /// Versión optimista de la definición (cada cambio la incrementa y queda en la auditoría).
  version                 Int                       @default(1)
  createdById             String                    @map("created_by_id") @db.Char(36)
  updatedById             String?                   @map("updated_by_id") @db.Char(36)
  createdAt               DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime                  @updatedAt @map("updated_at") @db.DateTime(3)

  clinic     Clinic              @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  procedures ClinicalProcedure[]

  @@unique([clinicId, code])
  @@unique([id, clinicId])
  @@map("procedure_definitions")
}

/// Visita clínica: atención de un paciente por su odontólogo responsable en una sede, amparada por una relación
/// asistencial vigente. Su núcleo es inmutable; solo cambia de OPEN a CLOSED o CANCELLED, una vez.
model ClinicalVisit {
  id                 String      @id @default(uuid()) @db.Char(36)
  clinicId           String      @map("clinic_id") @db.Char(36)
  patientId          String      @map("patient_id") @db.Char(36)
  branchId           String      @map("branch_id") @db.Char(36)
  /// Odontólogo responsable (el que abre la visita).
  dentistUserId      String      @map("dentist_user_id") @db.Char(36)
  /// Relación asistencial que amparó la apertura.
  careRelationshipId String      @map("care_relationship_id") @db.Char(36)
  /// Correlativo por paciente.
  visitNumber        Int         @map("visit_number")
  status             VisitStatus @default(OPEN)
  /// "paciente|odontólogo" mientras esté abierta: una visita abierta por paciente y odontólogo.
  openKey            String?     @unique @map("open_key") @db.VarChar(80)
  /// Motivo ADMINISTRATIVO (p. ej. "control"); no debe contener datos clínicos.
  reason             String?     @db.VarChar(300)
  startedAt          DateTime    @default(now()) @map("started_at") @db.DateTime(3)
  closedAt           DateTime?   @map("closed_at") @db.DateTime(3)
  cancelReason       String?     @map("cancel_reason") @db.VarChar(300)
  /// Reservado para la agenda (todavía no existe).
  appointmentId      String?     @map("appointment_id") @db.Char(36)
  /// Versión optimista: 1 al abrir, 2 al cerrar o cancelar.
  version            Int         @default(1)
  createdById        String      @map("created_by_id") @db.Char(36)

  patient       Patient             @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  branch        Branch              @relation(fields: [branchId, clinicId], references: [id, clinicId], onDelete: Restrict)
  dentist       User                @relation(fields: [dentistUserId], references: [id], onDelete: Restrict)
  diagnoses     ClinicalDiagnosis[]
  procedures    ClinicalProcedure[]
  clinicalNotes ClinicalNote[]
  services      VisitService[]
  appointment   Appointment?

  @@unique([patientId, visitNumber])
  @@unique([id, clinicId, patientId])
  @@index([clinicId, patientId, status])
  @@index([dentistUserId, status])
  @@map("clinical_visits")
}

/// Diagnóstico declarado por el profesional (una versión). Texto libre; el código es opcional y no valida contra ningún sistema.
model ClinicalDiagnosis {
  id            String               @id @default(uuid()) @db.Char(36)
  clinicId      String               @map("clinic_id") @db.Char(36)
  patientId     String               @map("patient_id") @db.Char(36)
  visitId       String               @map("visit_id") @db.Char(36)
  itemId        String               @map("item_id") @db.Char(36)
  version       Int
  supersedesId  String?              @map("supersedes_id") @db.Char(36)
  currentKey    String?              @unique @map("current_key") @db.Char(36)
  description   String               @db.VarChar(500)
  /// Código opcional de la clínica o de un sistema de codificación [por validar]; texto libre.
  code          String?              @db.VarChar(40)
  certainty     DiagnosisCertainty
  status        ClinicalRecordStatus @default(ACTIVE)
  changeKind    ClinicalChangeKind   @map("change_kind")
  /// Opcional en el alta; obligatorio desde la versión 2.
  changeReason  String?              @map("change_reason") @db.VarChar(300)
  changedFields Json?                @map("changed_fields")
  createdById   String               @map("created_by_id") @db.Char(36)
  createdAt     DateTime             @default(now()) @map("created_at") @db.DateTime(3)

  patient Patient       @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  visit   ClinicalVisit @relation(fields: [visitId, clinicId, patientId], references: [id, clinicId, patientId], onDelete: Restrict)

  @@unique([itemId, version])
  @@index([clinicId, patientId, currentKey])
  @@index([visitId, currentKey])
  @@map("clinical_diagnoses")
}

/// Procedimiento realizado (una versión): tipo del catálogo de la clínica, odontólogo responsable, fecha y estado.
/// Cerrarlo exige consentimiento clínico vigente solo si su definición lo requiere.
model ClinicalProcedure {
  id             String                   @id @default(uuid()) @db.Char(36)
  clinicId       String                   @map("clinic_id") @db.Char(36)
  patientId      String                   @map("patient_id") @db.Char(36)
  visitId        String                   @map("visit_id") @db.Char(36)
  itemId         String                   @map("item_id") @db.Char(36)
  version        Int
  supersedesId   String?                  @map("supersedes_id") @db.Char(36)
  currentKey     String?                  @unique @map("current_key") @db.Char(36)
  definitionId   String                   @map("definition_id") @db.Char(36)
  /// Copias del catálogo al registrarlo: el historial no cambia si el catálogo se edita después.
  definitionCode String                   @map("definition_code") @db.VarChar(40)
  definitionName String                   @map("definition_name") @db.VarChar(160)
  /// Odontólogo responsable (el de la visita).
  dentistUserId  String                   @map("dentist_user_id") @db.Char(36)
  notes          String?                  @db.VarChar(1000)
  performedAt    DateTime                 @map("performed_at") @db.DateTime(3)
  status         ProcedureStatus          @default(OPEN)
  closedAt       DateTime?                @map("closed_at") @db.DateTime(3)
  closureConsent ProcedureClosureConsent? @map("closure_consent")
  changeKind     ProcedureChangeKind      @map("change_kind")
  changeReason   String?                  @map("change_reason") @db.VarChar(300)
  changedFields  Json?                    @map("changed_fields")
  createdById    String                   @map("created_by_id") @db.Char(36)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.DateTime(3)

  patient    Patient             @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  visit      ClinicalVisit       @relation(fields: [visitId, clinicId, patientId], references: [id, clinicId, patientId], onDelete: Restrict)
  definition ProcedureDefinition @relation(fields: [definitionId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@unique([itemId, version])
  @@index([clinicId, patientId, currentKey])
  @@index([visitId, currentKey])
  @@map("clinical_procedures")
}

// ---------------------------------------------------------------------------
// Sub-incremento 3.4: evoluciones narrativas clínicas (una por visita).
// Borrador editable en el sitio por el odontólogo responsable; al CERRAR (con reautenticación, que NO es una firma
// digital, legal ni clínica) se crea una versión inmutable con hash de integridad. Corregir o rectificar crea una versión
// nueva enlazada a la anterior, con motivo. Nunca se borra. Sin recomendaciones automáticas, IA ni decisiones clínicas.
// ---------------------------------------------------------------------------

enum NoteStatus {
  DRAFT
  CLOSED
  DISCARDED
  ENTERED_IN_ERROR
}

enum NoteChangeKind {
  CREATED
  CLOSED
  CORRECTED
  RECTIFIED
  DISCARDED
  MARKED_IN_ERROR
}

model ClinicalNote {
  id            String         @id @default(uuid()) @db.Char(36)
  clinicId      String         @map("clinic_id") @db.Char(36)
  patientId     String         @map("patient_id") @db.Char(36)
  visitId       String         @map("visit_id") @db.Char(36)
  itemId        String         @map("item_id") @db.Char(36)
  version       Int
  supersedesId  String?        @map("supersedes_id") @db.Char(36)
  currentKey    String?        @unique @map("current_key") @db.Char(36)
  /// = visit_id mientras esta versión sea la vigente y esté en borrador o cerrada: una sola evolución activa por visita.
  visitKey      String?        @unique @map("visit_key") @db.Char(36)
  status        NoteStatus
  /// Relato de la evolución (texto del profesional). Nunca va a la auditoría.
  body          String         @db.VarChar(10000)
  /// Indicaciones y seguimiento (opcional).
  followUp      String?        @map("follow_up") @db.VarChar(2000)
  /// Ediciones del borrador en el sitio (solo mientras es DRAFT).
  revision      Int            @default(0)
  changeKind    NoteChangeKind @map("change_kind")
  /// Obligatorio al corregir, rectificar, descartar o marcar por error.
  changeReason  String?        @map("change_reason") @db.VarChar(300)
  /// SHA-256 del contenido al cerrar o corregir: evidencia de integridad, NO una firma.
  contentHash   String?        @map("content_hash") @db.Char(64)
  closedAt      DateTime?      @map("closed_at") @db.DateTime(3)
  /// Prueba de reautenticación consumida (id, nunca el token).
  reauthProofId String?        @map("reauth_proof_id") @db.Char(36)
  createdById   String         @map("created_by_id") @db.Char(36)
  createdAt     DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  patient Patient       @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  visit   ClinicalVisit @relation(fields: [visitId, clinicId, patientId], references: [id, clinicId, patientId], onDelete: Restrict)

  @@unique([itemId, version])
  @@index([clinicId, patientId, currentKey])
  @@index([visitId, currentKey])
  @@map("clinical_notes")
}

// ---------------------------------------------------------------------------
// Sub-incremento 3.5: odontograma digital versionado y exportable (una cadena por paciente).
// Representación ESTRUCTURADA por pieza (numeración FDI), superficies y estados. Formato clínico POR VALIDAR: no se
// afirma cumplimiento de normas del MINSA hasta su validación formal. Registra lo que el profesional declara: no genera
// tratamientos, presupuestos ni diagnósticos, ni recomienda nada. Sin planes de tratamiento ni presupuestos.
// ---------------------------------------------------------------------------

enum OdontogramStatus {
  DRAFT
  CLOSED
  DISCARDED
  ENTERED_IN_ERROR
}

enum OdontogramChangeKind {
  CREATED
  UPDATED
  CORRECTED
  RECTIFIED
  DISCARDED
  MARKED_IN_ERROR
}

enum OdontogramDentition {
  PERMANENT
  PRIMARY
  MIXED
}

model ClinicalOdontogram {
  id            String               @id @default(uuid()) @db.Char(36)
  clinicId      String               @map("clinic_id") @db.Char(36)
  patientId     String               @map("patient_id") @db.Char(36)
  version       Int
  supersedesId  String?              @map("supersedes_id") @db.Char(36)
  /// = patient_id en la versión vigente de la cadena; NULL en las reemplazadas.
  currentKey    String?              @unique @map("current_key") @db.Char(36)
  status        OdontogramStatus
  dentition     OdontogramDentition
  /// Estructura por pieza/superficie (validada por la aplicación contra la especificación). Texto clínico: jamás a la auditoría.
  data          Json
  /// Ediciones del borrador en el sitio.
  revision      Int                  @default(0)
  changeKind    OdontogramChangeKind @map("change_kind")
  /// Obligatorio al corregir, rectificar, descartar o marcar por error.
  changeReason  String?              @map("change_reason") @db.VarChar(300)
  /// SHA-256 del contenido al guardar la versión: evidencia de integridad, NO una firma.
  contentHash   String?              @map("content_hash") @db.Char(64)
  closedAt      DateTime?            @map("closed_at") @db.DateTime(3)
  reauthProofId String?              @map("reauth_proof_id") @db.Char(36)
  createdById   String               @map("created_by_id") @db.Char(36)
  createdAt     DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime             @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  patient Patient @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@unique([patientId, version])
  @@index([clinicId, patientId])
  @@map("clinical_odontograms")
}

// ---------------------------------------------------------------------------
// Incremento 4.0: agenda y citas. Sin cobros, caja, facturación, inventario, mensajería ni planes de tratamiento.
// La doble reserva se impide en la propia base de datos: cada cita (y cada bloqueo) ocupa huecos de 5 minutos del
// odontólogo y del consultorio en `appointment_slots`, con clave única por recurso y hueco.
// ---------------------------------------------------------------------------

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

enum AppointmentStatus {
  RESERVED
  CONFIRMED
  ATTENDED
  CANCELLED
  NO_SHOW
}

enum SlotResourceKind {
  DENTIST
  ROOM
}

enum SlotOwnerKind {
  APPOINTMENT
  BLOCK
}

enum BlockStatus {
  ACTIVE
  RELEASED
}

/// Consultorio de una sede.
model Room {
  id        String        @id @default(uuid()) @db.Char(36)
  clinicId  String        @map("clinic_id") @db.Char(36)
  branchId  String        @map("branch_id") @db.Char(36)
  name      String        @db.VarChar(80)
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.DateTime(3)

  clinic       Clinic         @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  branch       Branch         @relation(fields: [branchId, clinicId], references: [id, clinicId], onDelete: Restrict)
  appointments Appointment[]
  rules        ScheduleRule[]

  @@unique([branchId, name])
  @@unique([id, branchId])
  @@unique([id, clinicId])
  @@map("rooms")
}

/// Especialidad (catálogo de la clínica; apoyo administrativo, no una clasificación clínica).
model Specialty {
  id        String        @id @default(uuid()) @db.Char(36)
  clinicId  String        @map("clinic_id") @db.Char(36)
  name      String        @db.VarChar(80)
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.DateTime(3)

  clinic   Clinic             @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  services AgendaService[]
  dentists DentistSpecialty[]

  @@unique([clinicId, name])
  @@unique([id, clinicId])
  @@map("specialties")
}

/// Servicio agendable (tipo de cita) con duración configurable. NO es un procedimiento clínico.
/// Catálogo de productos y medicamentos que se venden en caja (precio de referencia por clínica).
/// El nombre coincide con el que el odontólogo escribe en la receta: así el precio sale solo al cobrar.
model Product {
  id           String        @id @default(uuid()) @db.Char(36)
  clinicId     String        @map("clinic_id") @db.Char(36)
  name         String        @db.VarChar(120)
  /// Presentación opcional (p. ej. «caja x 10», «frasco 120 ml»).
  presentation String?       @db.VarChar(80)
  /// Precio de venta en céntimos de sol (IGV incluido). En un servicio, el precio por pieza (diente) o por vez.
  priceCents   Int           @map("price_cents")
  /// PRODUCT: medicamento o producto que se vende en caja. SERVICE: tratamiento que el odontólogo registra en la atención.
  kind         ProductKind   @default(PRODUCT)
  status       CatalogStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  clinic        Clinic         @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  visitServices VisitService[]

  @@unique([clinicId, name])
  @@index([clinicId, status])
  @@map("products")
}

enum ProductKind {
  PRODUCT
  SERVICE
}

enum VisitServiceStatus {
  ACTIVE
  REMOVED
}

/// Servicio del catálogo realizado en una atención, con las piezas tratadas: es la cuenta que el paciente paga en caja.
/// Nombre y precio se copian al registrarlo (un cambio posterior del catálogo no altera lo ya hecho).
model VisitService {
  id             String             @id @default(uuid()) @db.Char(36)
  clinicId       String             @map("clinic_id") @db.Char(36)
  patientId      String             @map("patient_id") @db.Char(36)
  visitId        String             @map("visit_id") @db.Char(36)
  /// Servicio del catálogo; nulo = «otro servicio» escrito en la atención (nombre y precio propios).
  productId      String?            @map("product_id") @db.Char(36)
  name           String             @db.VarChar(120)
  unitPriceCents Int                @map("unit_price_cents")
  /// Piezas tratadas (numeración FDI, p. ej. ["16","26"]); vacío = el servicio no es por pieza.
  teeth          Json
  /// Piezas tratadas, o las veces que se hizo si no es por pieza.
  quantity       Int
  status         VisitServiceStatus @default(ACTIVE)
  /// Venta de Apiworking que lo cobró; nulo = pendiente de pago.
  saleId         String?            @map("sale_id") @db.Char(36)
  createdById    String             @map("created_by_id") @db.Char(36)
  createdAt      DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  removedAt      DateTime?          @map("removed_at") @db.DateTime(3)

  visit   ClinicalVisit @relation(fields: [visitId], references: [id], onDelete: Restrict)
  product Product?      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([clinicId, patientId, status, saleId])
  @@index([visitId])
  @@index([saleId])
  @@map("visit_services")
}

model AgendaService {
  id              String        @id @default(uuid()) @db.Char(36)
  clinicId        String        @map("clinic_id") @db.Char(36)
  name            String        @db.VarChar(120)
  specialtyId     String?       @map("specialty_id") @db.Char(36)
  durationMinutes Int           @map("duration_minutes")
  /// Precio de referencia en céntimos de sol (opcional); sugiere el monto al registrar el cobro de una atención.
  priceCents      Int?          @map("price_cents")
  status          CatalogStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at") @db.DateTime(3)

  clinic          Clinic           @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  specialty       Specialty?       @relation(fields: [specialtyId, clinicId], references: [id, clinicId], onDelete: Restrict)
  appointments    Appointment[]
  bookingRequests BookingRequest[]

  @@unique([clinicId, name])
  @@unique([id, clinicId])
  @@map("agenda_services")
}

model DentistSpecialty {
  clinicId    String @map("clinic_id") @db.Char(36)
  userId      String @map("user_id") @db.Char(36)
  specialtyId String @map("specialty_id") @db.Char(36)

  specialty Specialty @relation(fields: [specialtyId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@id([userId, specialtyId])
  @@index([clinicId])
  @@map("dentist_specialties")
}

/// Horario recurrente semanal de un odontólogo en una sede (hora local de Lima, en minutos desde la medianoche).
model ScheduleRule {
  id            String        @id @default(uuid()) @db.Char(36)
  clinicId      String        @map("clinic_id") @db.Char(36)
  branchId      String        @map("branch_id") @db.Char(36)
  dentistUserId String        @map("dentist_user_id") @db.Char(36)
  /// Consultorio habitual (opcional): se ofrece primero.
  roomId        String?       @map("room_id") @db.Char(36)
  /// 1 = lunes … 7 = domingo.
  weekday       Int
  startMinute   Int           @map("start_minute")
  endMinute     Int           @map("end_minute")
  validFrom     DateTime      @map("valid_from") @db.Date
  validUntil    DateTime?     @map("valid_until") @db.Date
  status        CatalogStatus @default(ACTIVE)
  createdById   String        @map("created_by_id") @db.Char(36)
  createdAt     DateTime      @default(now()) @map("created_at") @db.DateTime(3)

  room Room? @relation(fields: [roomId, branchId], references: [id, branchId], onDelete: Restrict)

  @@index([clinicId, branchId, dentistUserId, status])
  @@map("schedule_rules")
}

/// Bloqueo o excepción (vacaciones, mantenimiento, reunión) de un odontólogo o de un consultorio.
model ScheduleBlock {
  id            String      @id @default(uuid()) @db.Char(36)
  clinicId      String      @map("clinic_id") @db.Char(36)
  branchId      String      @map("branch_id") @db.Char(36)
  dentistUserId String?     @map("dentist_user_id") @db.Char(36)
  roomId        String?     @map("room_id") @db.Char(36)
  startsAt      DateTime    @map("starts_at") @db.DateTime(3)
  endsAt        DateTime    @map("ends_at") @db.DateTime(3)
  reason        String      @db.VarChar(300)
  status        BlockStatus @default(ACTIVE)
  createdById   String      @map("created_by_id") @db.Char(36)
  createdAt     DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  releasedAt    DateTime?   @map("released_at") @db.DateTime(3)
  releasedById  String?     @map("released_by_id") @db.Char(36)
  releaseReason String?     @map("release_reason") @db.VarChar(300)

  @@index([clinicId, branchId, startsAt])
  @@map("schedule_blocks")
}

/// Cita. El paciente, la sede y el consultorio quedan atados a la clínica con claves foráneas compuestas.
model Appointment {
  id               String            @id @default(uuid()) @db.Char(36)
  clinicId         String            @map("clinic_id") @db.Char(36)
  branchId         String            @map("branch_id") @db.Char(36)
  patientId        String            @map("patient_id") @db.Char(36)
  dentistUserId    String            @map("dentist_user_id") @db.Char(36)
  roomId           String            @map("room_id") @db.Char(36)
  serviceId        String            @map("service_id") @db.Char(36)
  startsAt         DateTime          @map("starts_at") @db.DateTime(3)
  endsAt           DateTime          @map("ends_at") @db.DateTime(3)
  status           AppointmentStatus @default(RESERVED)
  /// Nota ADMINISTRATIVA (p. ej. "llega con su mamá"); no debe contener datos clínicos.
  notes            String?           @db.VarChar(300)
  /// Versión optimista: cada cambio la incrementa.
  version          Int               @default(1)
  createdById      String            @map("created_by_id") @db.Char(36)
  confirmedById    String?           @map("confirmed_by_id") @db.Char(36)
  confirmedAt      DateTime?         @map("confirmed_at") @db.DateTime(3)
  cancelReason     String?           @map("cancel_reason") @db.VarChar(300)
  noShowReason     String?           @map("no_show_reason") @db.VarChar(300)
  rescheduledCount Int               @default(0) @map("rescheduled_count")
  /// Visita clínica a la que dio origen al iniciar la atención.
  visitId          String?           @unique @map("visit_id") @db.Char(36)
  attendedAt       DateTime?         @map("attended_at") @db.DateTime(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  patient        Patient         @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  branch         Branch          @relation(fields: [branchId, clinicId], references: [id, clinicId], onDelete: Restrict)
  room           Room            @relation(fields: [roomId, branchId], references: [id, branchId], onDelete: Restrict)
  service        AgendaService   @relation(fields: [serviceId, clinicId], references: [id, clinicId], onDelete: Restrict)
  dentist        User            @relation(fields: [dentistUserId], references: [id], onDelete: Restrict)
  visit          ClinicalVisit?  @relation(fields: [visitId], references: [id], onDelete: Restrict)
  bookingRequest BookingRequest?

  @@index([clinicId, branchId, startsAt])
  @@index([dentistUserId, startsAt])
  @@index([patientId, startsAt])
  @@map("appointments")
}

/// Huecos de 5 minutos ocupados por una cita o un bloqueo, por odontólogo y por consultorio. La clave primaria
/// (recurso + hueco) hace imposible que dos citas ocupen el mismo odontólogo o consultorio a la vez, aunque
/// dos solicitudes lleguen simultáneamente.
model AppointmentSlot {
  resourceKind SlotResourceKind @map("resource_kind")
  resourceId   String           @map("resource_id") @db.Char(36)
  slotStart    DateTime         @map("slot_start") @db.DateTime(0)
  ownerKind    SlotOwnerKind    @map("owner_kind")
  ownerId      String           @map("owner_id") @db.Char(36)
  clinicId     String           @map("clinic_id") @db.Char(36)

  @@id([resourceKind, resourceId, slotStart])
  @@index([ownerKind, ownerId])
  @@index([clinicId, slotStart])
  @@map("appointment_slots")
}

// ======================================================================================================
// 4.1 Cobros, comprobantes, cola (outbox), fidelización y reseñas SIMULADOS. Solo con INTEGRATIONS_MODE=mock.
// Nada de esto contiene datos clínicos. Los comprobantes llevan siempre la marca «DEMO — NO VÁLIDO PARA SUNAT».
// ======================================================================================================

enum ChargeStatus {
  PENDING
  PAID
  VOIDED
}

enum PaymentMethod {
  CASH
  CARD
  YAPE_PLIN
  TRANSFER
}

enum BillingDocumentType {
  BOLETA
  FACTURA
}

enum BillingDocumentStatus {
  PENDING_SEND
  SENT
  ISSUED
  REJECTED
  RETRYABLE_ERROR
  NEEDS_RECONCILIATION
}

enum OutboxKind {
  BILLING_EMIT
  LOYALTY_ACCRUE
  REVIEW_REQUEST
}

enum OutboxStatus {
  PENDING
  DONE
  FAILED
  SKIPPED
}

/// Cobro de una atención. El monto es inmutable; el pago y la anulación son los únicos cambios de estado.
model Charge {
  id             String         @id @default(uuid()) @db.Char(36)
  clinicId       String         @map("clinic_id") @db.Char(36)
  branchId       String         @map("branch_id") @db.Char(36)
  patientId      String         @map("patient_id") @db.Char(36)
  /// Cita que originó el cobro (administrativo; no enlaza a la visita clínica).
  appointmentId  String?        @map("appointment_id") @db.Char(36)
  /// = appointmentId mientras el cobro no esté anulado: un solo cobro vigente por cita.
  appointmentKey String?        @unique @map("appointment_key") @db.Char(36)
  description    String         @db.VarChar(200)
  amountCents    Int            @map("amount_cents")
  currency       String         @default("PEN") @db.Char(3)
  status         ChargeStatus   @default(PENDING)
  paymentMethod  PaymentMethod? @map("payment_method")
  paidAt         DateTime?      @map("paid_at") @db.DateTime(3)
  paidById       String?        @map("paid_by_id") @db.Char(36)
  voidReason     String?        @map("void_reason") @db.VarChar(300)
  createdById    String         @map("created_by_id") @db.Char(36)
  version        Int            @default(1)
  createdAt      DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  patient   Patient           @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  documents BillingDocument[]

  @@unique([id, clinicId])
  @@index([clinicId, status, createdAt])
  @@index([patientId, createdAt])
  @@map("charges")
}

/// Comprobante SIMULADO. `demoMark` es obligatorio y exacto (CHECK en la base de datos).
model BillingDocument {
  id                String                @id @default(uuid()) @db.Char(36)
  clinicId          String                @map("clinic_id") @db.Char(36)
  chargeId          String                @map("charge_id") @db.Char(36)
  type              BillingDocumentType
  series            String                @db.VarChar(8)
  number            Int
  status            BillingDocumentStatus @default(PENDING_SEND)
  customerName      String                @map("customer_name") @db.VarChar(200)
  customerDocType   String                @map("customer_doc_type") @db.VarChar(10)
  customerDocNumber String                @map("customer_doc_number") @db.VarChar(20)
  amountCents       Int                   @map("amount_cents")
  igvCents          Int                   @map("igv_cents")
  demoMark          String                @map("demo_mark") @db.VarChar(60)
  /// Clave de idempotencia ante el proveedor: reenviar la misma clave nunca duplica el comprobante.
  idempotencyKey    String                @unique @map("idempotency_key") @db.VarChar(100)
  /// = chargeId mientras el comprobante no esté rechazado: un solo comprobante vigente por cobro.
  activeKey         String?               @unique @map("active_key") @db.Char(36)
  providerRef       String?               @map("provider_ref") @db.VarChar(80)
  rejectionReason   String?               @map("rejection_reason") @db.VarChar(300)
  /// Pista de la simulación (qué debe responder el simulador). Nulo cuando exista un proveedor real.
  scenario          String?               @db.VarChar(20)
  attempts          Int                   @default(0)
  lastAttemptAt     DateTime?             @map("last_attempt_at") @db.DateTime(3)
  issuedAt          DateTime?             @map("issued_at") @db.DateTime(3)
  createdById       String                @map("created_by_id") @db.Char(36)
  createdAt         DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime              @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  charge Charge @relation(fields: [chargeId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@unique([clinicId, series, number])
  @@index([clinicId, status])
  @@map("billing_documents")
}

/// Correlativo por clínica y serie (se toma con bloqueo de fila).
model BillingCounter {
  clinicId String @map("clinic_id") @db.Char(36)
  series   String @db.VarChar(8)
  last     Int    @default(0)

  @@id([clinicId, series])
  @@map("billing_counters")
}

/// Cola de integraciones: el cambio local y el mensaje se guardan en la MISMA transacción; un procesador los entrega.
model IntegrationOutbox {
  id             String       @id @default(uuid()) @db.Char(36)
  clinicId       String       @map("clinic_id") @db.Char(36)
  kind           OutboxKind
  aggregateType  String       @map("aggregate_type") @db.VarChar(40)
  aggregateId    String       @map("aggregate_id") @db.Char(36)
  idempotencyKey String       @unique @map("idempotency_key") @db.VarChar(100)
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  nextAttemptAt  DateTime     @default(now()) @map("next_attempt_at") @db.DateTime(3)
  /// Texto breve y sin datos sensibles.
  note           String?      @db.VarChar(300)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  processedAt    DateTime?    @map("processed_at") @db.DateTime(3)

  @@index([status, nextAttemptAt])
  @@index([clinicId, status])
  @@map("integration_outbox")
}

/// Estado que «recordaría» el proveedor de comprobantes simulado, por clave de idempotencia (solo mock).
model MockProviderRecord {
  idempotencyKey String   @id @map("idempotency_key") @db.VarChar(100)
  kind           String   @db.VarChar(20)
  state          String   @db.VarChar(20)
  attempts       Int      @default(0)
  result         Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("mock_provider_records")
}

/// Libro de puntos del proveedor de fidelización simulado (solo mock).
model MockLoyaltyEntry {
  id             String   @id @default(uuid()) @db.Char(36)
  clinicId       String   @map("clinic_id") @db.Char(36)
  patientRef     String   @map("patient_ref") @db.Char(36)
  kind           String   @db.VarChar(12)
  points         Int
  reason         String?  @db.VarChar(200)
  idempotencyKey String   @unique @map("idempotency_key") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([clinicId, patientRef, createdAt])
  @@map("mock_loyalty_entries")
}

/// Solicitudes de reseña del proveedor simulado (solo mock).
model MockReviewRequest {
  id             String   @id @default(uuid()) @db.Char(36)
  clinicId       String   @map("clinic_id") @db.Char(36)
  patientRef     String   @map("patient_ref") @db.Char(36)
  idempotencyKey String   @unique @map("idempotency_key") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([clinicId, createdAt])
  @@map("mock_review_requests")
}

// ------------------------------------------------------------------ 5: solicitudes de cita desde la web pública

enum BookingRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// Solicitud de cita enviada desde la web pública. No es una cita ni una ficha de paciente: recepción la atiende
/// (elige o crea al paciente, asigna odontólogo y horario) y solo entonces nace la cita. Datos administrativos mínimos.
model BookingRequest {
  id                String               @id @default(uuid()) @db.Char(36)
  /// Código corto que ve el solicitante («SOL-7K3M9Q»). No revela datos.
  reference         String               @unique @db.VarChar(16)
  clinicId          String               @map("clinic_id") @db.Char(36)
  branchId          String               @map("branch_id") @db.Char(36)
  serviceId         String               @map("service_id") @db.Char(36)
  /// Horario que pidió (no se reserva: dos personas pueden pedir el mismo).
  desiredStartsAt   DateTime             @map("desired_starts_at") @db.DateTime(3)
  firstName         String               @map("first_name") @db.VarChar(100)
  lastName          String               @map("last_name") @db.VarChar(100)
  secondLastName    String?              @map("second_last_name") @db.VarChar(100)
  documentType      String?              @map("document_type") @db.VarChar(12)
  documentNumber    String?              @map("document_number") @db.VarChar(40)
  /// 9 dígitos, sin prefijo.
  mobile            String               @db.VarChar(20)
  email             String?              @db.VarChar(254)
  /// Nota ADMINISTRATIVA; sin datos clínicos.
  notes             String?              @db.VarChar(300)
  privacyAcceptedAt DateTime             @map("privacy_accepted_at") @db.DateTime(3)
  status            BookingRequestStatus @default(PENDING)
  appointmentId     String?              @unique @map("appointment_id") @db.Char(36)
  patientId         String?              @map("patient_id") @db.Char(36)
  decidedById       String?              @map("decided_by_id") @db.Char(36)
  decidedAt         DateTime?            @map("decided_at") @db.DateTime(3)
  rejectReason      String?              @map("reject_reason") @db.VarChar(300)
  createdAt         DateTime             @default(now()) @map("created_at") @db.DateTime(3)

  branch      Branch        @relation(fields: [branchId, clinicId], references: [id, clinicId], onDelete: Restrict)
  service     AgendaService @relation(fields: [serviceId, clinicId], references: [id, clinicId], onDelete: Restrict)
  appointment Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@index([clinicId, status, createdAt])
  @@index([mobile, status])
  @@map("booking_requests")
}

// --- Apiworking (integración real): identidad externa y ventas por registro-documento ---

/// Vínculo de un usuario local con su cuenta de Apiworking. El usuario local nace sin roles: los permisos son SIEMPRE locales;
/// los roles externos se guardan solo como información (nunca se convierten en roles locales).
model ExternalIdentity {
  id               String   @id @default(uuid()) @db.Char(36)
  userId           String   @unique @map("user_id") @db.Char(36)
  provider         String   @db.VarChar(20)
  /// empresa.base_datos del login (p. ej. prod_ti_tiendaglowsmile).
  tenant           String   @db.VarChar(120)
  externalUserId   String   @map("external_user_id") @db.VarChar(40)
  externalUsername String   @map("external_username") @db.VarChar(120)
  externalBranchId String?  @map("external_branch_id") @db.VarChar(40)
  externalRoles    Json?    @map("external_roles")
  lastLoginAt      DateTime @map("last_login_at") @db.DateTime(3)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, tenant, externalUserId])
  @@map("external_identities")
}

/// Estado del DOCUMENTO en Apiworking. SENT solo con respuesta correcta y referencia (idComprobante).
enum ApiworkingDocStatus {
  /// Contingencia: se cobró en la caja local porque Apiworking no respondía; el documento está por emitir (a mano, con aprobación).
  PENDING_ISSUE
  PENDING
  SENT
  REJECTED
  PENDING_RECONCILIATION
}

/// El cobro es un estado APARTE: registrar el documento no aplica el pago (problema conocido del proveedor).
enum ApiworkingPaymentStatus {
  NO_EVIDENCE
  CONFIRMED_REMOTE
  CONFIRMED_RECONCILED
}

enum ApiworkingVoidStatus {
  IN_PROGRESS
  VOIDED
  TO_RECONCILE
}

/// Venta registrada en Apiworking (registro-documento). Nunca se reenvía sola: un tiempo agotado = resultado desconocido.
model ApiworkingSale {
  id                 String                  @id @default(uuid()) @db.Char(36)
  clinicId           String                  @map("clinic_id") @db.Char(36)
  tenant             String                  @db.VarChar(120)
  /// Clave local: la misma clave nunca envía dos veces la misma operación.
  idempotencyKey     String                  @unique @map("idempotency_key") @db.VarChar(64)
  /// SHA-256 del JSON exacto aprobado por la persona antes del envío.
  requestHash        String                  @map("request_hash") @db.Char(64)
  patientId          String?                 @map("patient_id") @db.Char(36)
  /// Cita atendida que originó la venta (una sola venta vigente por cita).
  appointmentId      String?                 @map("appointment_id") @db.Char(36)
  /// Venta registrada en contingencia: el dinero entró en la caja local y el documento sigue por emitir.
  contingency        Boolean                 @default(false)
  /// Movimiento de la caja local que registró el cobro en contingencia.
  cashMovementId     String?                 @map("cash_movement_id") @db.Char(36)
  externalCustomerId String                  @map("external_customer_id") @db.VarChar(40)
  customerName       String                  @map("customer_name") @db.VarChar(200)
  customerDocType    String                  @map("customer_doc_type") @db.VarChar(20)
  customerDocNumber  String                  @map("customer_doc_number") @db.VarChar(20)
  idCaja             String                  @map("id_caja") @db.VarChar(40)
  idSerie            String                  @map("id_serie") @db.VarChar(40)
  serie              String?                 @db.VarChar(20)
  documentTypeId     String                  @map("document_type_id") @db.VarChar(40)
  paymentMethodId    String                  @map("payment_method_id") @db.VarChar(40)
  description        String                  @db.VarChar(200)
  /// Líneas tal como se enviaron: [{ name, quantity, unitPriceCents }].
  lines              Json
  /// Total COBRADO (ya con el descuento).
  totalCents         Int                     @map("total_cents")
  /// Descuento sobre la suma de las líneas (0 = sin descuento).
  discountCents      Int                     @default(0) @map("discount_cents")
  /// Pago con varios medios: [{ idMetodoPago, amountCents }]. Nulo = un solo medio (paymentMethodId) por el total.
  payments           Json?
  docDate            DateTime                @map("doc_date") @db.Date
  docStatus          ApiworkingDocStatus     @default(PENDING) @map("doc_status")
  paymentStatus      ApiworkingPaymentStatus @default(NO_EVIDENCE) @map("payment_status")
  voidStatus         ApiworkingVoidStatus?   @map("void_status")
  /// idComprobante devuelto por Apiworking.
  externalDocId      String?                 @map("external_doc_id") @db.VarChar(40)
  externalNumber     String?                 @map("external_number") @db.VarChar(40)
  failureReason      String?                 @map("failure_reason") @db.VarChar(300)
  /// Momento del envío real (nulo = nunca se llamó a Apiworking).
  attemptedAt        DateTime?               @map("attempted_at") @db.DateTime(3)
  createdById        String                  @map("created_by_id") @db.Char(36)
  createdAt          DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([clinicId, createdAt])
  @@index([tenant, attemptedAt])
  @@index([appointmentId])
  @@map("apiworking_sales")
}

/// Espejo local de los clientes de Apiworking (los que se crean por ClienteDoc y los que se usan en ventas): permite buscar
/// aunque Apiworking no responda o no devuelva el cliente. Apiworking sigue siendo la fuente de verdad del id.
model ApiworkingCustomer {
  id                 String   @id @default(uuid()) @db.Char(36)
  clinicId           String   @map("clinic_id") @db.Char(36)
  tenant             String   @db.VarChar(120)
  externalCustomerId String   @map("external_customer_id") @db.VarChar(40)
  /// Código de tipoDoc de Apiworking: DNI 1, RUC 6, CE 4, pasaporte 7, no domiciliado 0.
  docType            String   @map("doc_type") @db.VarChar(2)
  docNumber          String   @map("doc_number") @db.VarChar(20)
  /// Nombre de referencia: Apiworking completa el suyo y no lo devuelve al crear.
  name               String   @db.VarChar(200)
  createdById        String   @map("created_by_id") @db.Char(36)
  createdAt          DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([tenant, externalCustomerId])
  @@unique([tenant, docType, docNumber])
  @@index([clinicId, name])
  @@map("apiworking_customers")
}
