# PLANTILLA del .env de UNA instancia. La completa deploy/scripts/instance-new.sh; destino: /etc/apidental/__NAME__.env
# Permisos 600, propietario root:apidental. NUNCA en Git ni compartido entre clientes (credenciales y BD propias).
NODE_ENV=production
HOST=127.0.0.1
PORT=__PORT__
TRUST_PROXY=1

# --- Base de datos propia de este cliente ---
DATABASE_URL=mysql://__DB_USER__:__DB_PASSWORD__@127.0.0.1:3306/__DB_NAME__
# Solo para migrar (usuario con DDL/TRIGGER). deploy.sh la usa como DATABASE_URL al migrar; la API no la lee.
MIGRATE_DATABASE_URL=mysql://__DB_MIGRATE_USER__:__DB_MIGRATE_PASSWORD__@127.0.0.1:3306/__DB_NAME__

# --- Seguridad: secreto y emisor PROPIOS, para que un token de un cliente no valga en otro ---
JWT_ACCESS_SECRET=__JWT_SECRET__
JWT_ISSUER=apidental-api-__NAME__
JWT_AUDIENCE=apidental-admin-__NAME__

# --- Panel y API de este cliente ---
CORS_ORIGINS=https://__PANEL_HOST__
ATTACHMENTS_DIR=__FILES_BASE__/__NAME__
INVITATION_DELIVERY_MODE=disabled
# PUBLIC_BOOKING_CLINIC_ID=<uuid de la clínica>   (opcional; vacío no es válido: déjelo comentado si no hay reserva pública)

# --- Integraciones ---
# off  = sin integraciones. mock = simuladores (demos). El Apiworking REAL es independiente de este modo (ver abajo).
INTEGRATIONS_MODE=__INTEGRATIONS_MODE__
__MOCK_PRODUCTION_FLAG__

# --- Apiworking REAL (solo clientes con tenant propio; ver docs/arquitectura/apiworking-real.md) ---
# Cada cliente usa SU tenant, cajas, series y credenciales: nunca copie estos valores de otra instancia.
# AUTH_MODE=apiworking
# APIWORKING_SYSTEM_ID=
# APIWORKING_AUTHZ_EXPECTED_DATABASE=
# APIWORKING_AUTHZ_READ=true
# APIWORKING_AUTHZ_WRITE=false          # se activa solo cuando el titular aprobó la primera escritura
# APIWORKING_MAX_REAL_OPERATIONS=       # OPCIONAL: tope de envíos reales por 24 h; sin la variable (o 0) no hay tope
# APIWORKING_AUTHORIZED_CASH_REGISTERS=
# APIWORKING_AUTHORIZED_DOCUMENT_TYPES=
# APIWORKING_AUTHORIZED_SERIES=
# APIWORKING_CASH_OPERATION_TYPES=1:I:Reposición de caja,2:E:Movilidad,3:E:Viáticos,4:E:Servicio público,5:E:Compras   # OPCIONAL: códigos de ingreso-egreso del tenant (sin la variable, estos)
# APIWORKING_WAREHOUSE_ID=
# APIWORKING_UNIT_ID=
