# PLANTILLA — no se aplica automáticamente. Copiar a /etc/nginx/sites-available/, revisar y habilitar.
# Certificados: emitidos con certbot (rutas por defecto de Let's Encrypt).

limit_req_zone $binary_remote_addr zone=apidental_login:10m rate=10r/m;

# --- Sitio comercial (Next.js, futuro) y panel (React/Vite, futuro) ---
server {
    listen 443 ssl http2;
    server_name dental.apiworking.com.pe;

    ssl_certificate     /etc/letsencrypt/live/dental.apiworking.com.pe/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dental.apiworking.com.pe/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Panel: build estático de apps/admin (base '/admin/'; `npm run admin:build`).
    location /admin/ {
        alias /var/www/apidental/admin/;
        try_files $uri $uri/ /admin/index.html;
    }

    # La API también se expone en este host (mismo origen que el panel): la cookie del refresh token y la protección CSRF
    # funcionan sin CORS. El panel llama a rutas relativas /v1/... CORS_ORIGINS debe incluir https://dental.apiworking.com.pe
    location /v1/ {
        client_max_body_size 1m;
        include /etc/nginx/snippets/apidental-api-proxy.conf;
    }

    # Sitio público (landing y solicitud de citas): archivos estáticos de apps/site, copiados a /var/www/apidental/site.
    # La API ya está en este mismo host (/v1/), así que no hay CORS. Requiere PUBLIC_BOOKING_CLINIC_ID en el entorno de la API.
    location / {
        root /var/www/apidental/site;
        index index.html;
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }
}

# --- API NestJS ---
server {
    listen 443 ssl http2;
    server_name api.dental.apiworking.com.pe;

    ssl_certificate     /etc/letsencrypt/live/api.dental.apiworking.com.pe/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.dental.apiworking.com.pe/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 1m;   # por defecto, cuerpos pequeños (JSON)

    # Carga de adjuntos de pacientes: único lugar con un límite mayor (ATTACHMENT_MAX_BYTES + márgenes del multipart).
    location ~ ^/v1/patients/[0-9a-fA-F-]{36}/attachments$ {
        client_max_body_size 11m;
        include /etc/nginx/snippets/apidental-api-proxy.conf;
    }

    # El directorio de adjuntos (ATTACHMENTS_DIR) NO debe estar bajo ningún root/alias de Nginx:
    # los archivos solo salen por la API, autenticados y auditados.

    location = /v1/auth/login {
        limit_req zone=apidental_login burst=5 nodelay;
        include /etc/nginx/snippets/apidental-api-proxy.conf;
    }

    location / {
        include /etc/nginx/snippets/apidental-api-proxy.conf;
    }
}

server {
    listen 80;
    server_name dental.apiworking.com.pe api.dental.apiworking.com.pe;
    return 301 https://$host$request_uri;
}

# /etc/nginx/snippets/apidental-api-proxy.conf:
#   proxy_pass http://127.0.0.1:3000;
#   proxy_set_header Host $host;
#   proxy_set_header X-Real-IP $remote_addr;
#   proxy_set_header X-Forwarded-For $remote_addr;   # no reenviar cabeceras del cliente
#   proxy_set_header X-Forwarded-Proto $scheme;
#   proxy_read_timeout 30s;
# Con este proxy delante, defina TRUST_PROXY=1 en el entorno de la API.
