# PLANTILLA POR CLIENTE — no se aplica sola. La genera deploy/scripts/instance-new.sh sustituyendo:
#   __NAME__ nombre de la instancia · __PANEL_HOST__ panel y sitio · __API_HOST__ API · __PORT__ puerto local de la API
# Copiar a /etc/nginx/sites-available/apidental-__NAME__.conf, emitir los certificados con certbot, revisar y habilitar.
# Requiere una sola vez en el servidor (compartido por todas las instancias):
#   - limit_req_zone $binary_remote_addr zone=apidental_login:10m rate=10r/m;   (ya existe en apidental.conf.example)
#   - /etc/nginx/snippets/apidental-proxy-headers.conf  (ver deploy/nginx/apidental-proxy-headers.conf.example)
# El build del panel (/var/www/apidental/admin) y el sitio (/var/www/apidental/site) son los MISMOS para todos los clientes.

# --- Panel y sitio público de __NAME__ ---
server {
    listen 443 ssl http2;
    server_name __PANEL_HOST__;

    ssl_certificate     /etc/letsencrypt/live/__PANEL_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__PANEL_HOST__/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;

    location /admin/ {
        alias /var/www/apidental/admin/;
        try_files $uri $uri/ /admin/index.html;
    }

    # La API de ESTA instancia, en el mismo origen que el panel (la cookie y el CSRF funcionan sin CORS).
    location /v1/ {
        client_max_body_size 1m;
        proxy_pass http://127.0.0.1:__PORT__;
        include /etc/nginx/snippets/apidental-proxy-headers.conf;
    }

    location / {
        root /var/www/apidental/site;
        index index.html;
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }
}

# --- API de __NAME__ ---
server {
    listen 443 ssl http2;
    server_name __API_HOST__;

    ssl_certificate     /etc/letsencrypt/live/__API_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__API_HOST__/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 1m;

    location ~ ^/v1/patients/[0-9a-fA-F-]{36}/attachments$ {
        client_max_body_size 11m;
        proxy_pass http://127.0.0.1:__PORT__;
        include /etc/nginx/snippets/apidental-proxy-headers.conf;
    }

    location = /v1/auth/login {
        limit_req zone=apidental_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:__PORT__;
        include /etc/nginx/snippets/apidental-proxy-headers.conf;
    }

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        include /etc/nginx/snippets/apidental-proxy-headers.conf;
    }
}

server {
    listen 80;
    server_name __PANEL_HOST__ __API_HOST__;
    return 301 https://$host$request_uri;
}
