# PLANTILLA — copiar a /etc/systemd/system/apidental-api@.service y ajustar rutas.
# Una instancia por cliente: `systemctl enable --now apidental-api@demod1` lee /etc/apidental/demod1.env
# y escribe adjuntos solo en /var/www/apidental/files/demod1 (rutas del VPS de producción: ajústelas si cambia el servidor). El nombre de la instancia (%i) es el del cliente.
[Unit]
Description=ApiDental API (NestJS) — instancia %i
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=apidental
Group=apidental
WorkingDirectory=/var/www/apidental/app/apps/api
# Variables de entorno de ESTA instancia (NODE_ENV=production, PORT, DATABASE_URL, JWT_ACCESS_SECRET, ...).
# Archivo con permisos 600 y propietario root:apidental; NUNCA dentro del repositorio ni compartido entre clientes.
EnvironmentFile=/etc/apidental/%i.env
ExecStart=/var/www/apidental/node/bin/node dist/main.js
Restart=on-failure
RestartSec=5

# Endurecimiento
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# Directorio privado de adjuntos de ESTA instancia (ATTACHMENTS_DIR): único lugar con escritura.
ReadWritePaths=/var/www/apidental/files/%i

[Install]
WantedBy=multi-user.target
