{
  "name": "apidental",
  "version": "0.1.0",
  "private": true,
  "description": "ApiDental: gestión odontológica (monorepo)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/api",
    "apps/admin"
  ],
  "scripts": {
    "api:dev": "npm run start:dev -w apps/api",
    "build": "npm run build -w apps/api && npm run build -w apps/admin",
    "lint": "npm run lint -w apps/api && npm run lint -w apps/admin",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/admin",
    "test": "npm run test -w apps/api && npm run test -w apps/admin",
    "test:e2e": "npm run test:e2e -w apps/api",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "format": "prettier --write .",
    "admin:dev": "npm run dev -w apps/admin",
    "admin:build": "npm run build -w apps/admin",
    "admin:test": "npm run test -w apps/admin"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  },
  "overrides": {
    "mariadb": "3.5.4",
    "mysql2": "^3.24.0",
    "deepmerge-ts": "^8.0.0"
  }
}
